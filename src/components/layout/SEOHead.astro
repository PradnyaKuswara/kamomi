---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = "Kamomi.id — Platform Manajemen Hunian Digital",
  description = "Kamomi.id — Platform manajemen hunian digital berbasis QR Code. Kelola kamar kost, homestay, dan villa dengan mudah, efisien, dan modern.",
  keywords = "kamomi, manajemen kost, guestbook digital, qr code kost, aplikasi kost, kelola homestay, manajemen villa",
  image = "/logo.png",
  type = "website",
  noindex = false,
} = Astro.props;

const siteName = "Kamomi.id";
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>{title}</title>
  
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Kamomi.id" />
  <meta name="application-name" content="Kamomi.id" />
  <meta name="apple-mobile-web-app-title" content="Kamomi.id" />
  
  {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
  
  <!-- Favicon & Touch Icons with official Kamomi Logo -->
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <!-- Sitemap & Webmanifest -->
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#2c5a8c" />
  <meta name="msapplication-TileColor" content="#2c5a8c" />
  <link rel="preload" href="/logo.png" as="image" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content={siteName} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Theme Script -->
  <script is:inline>
    const theme = localStorage.getItem("theme");
    if (
      theme === "dark" ||
      (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.classList.add("dark");
      document.documentElement.setAttribute("data-theme", "dark");
    } else {
      document.documentElement.classList.remove("dark");
      document.documentElement.setAttribute("data-theme", "light");
    }
  </script>
</head>
