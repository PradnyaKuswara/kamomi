---
import Logo from "../brand/Logo";

---

<footer class="w-full bg-[var(--bg-subtle)] pt-6 pb-10 px-3 sm:px-8">
  <div
    class="max-w-7xl mx-auto rounded-2xl sm:rounded-[2.5rem] bg-slate-950 text-slate-300 p-6 sm:p-12 border border-slate-800 shadow-2xl relative overflow-hidden"
  >
    <!-- Decorative background glow -->
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <!-- Main Footer Grid -->
    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-8 sm:gap-12">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-1 space-y-4 sm:space-y-5">
        <Logo tone="light" markClassName="h-9 w-9 sm:h-10 sm:w-10" textClassName="text-xl sm:text-2xl" />
        <p class="text-xs text-slate-400 leading-relaxed max-w-xs font-medium">
          Platform manajemen hunian digital berbasis QR Code. Kelola kamar kost, homestay, dan villa dalam satu alur kerja modern.
        </p>
        <div class="flex gap-3 pt-1">
          <a
            href="https://instagram.com/kamomi.id"
            target="_blank"
            rel="noopener noreferrer"
            class="h-9 w-9 sm:h-10 sm:w-10 rounded-full bg-slate-900 hover:bg-[var(--color-primary-hover)] border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white transition-all transform hover:scale-110"
            title="Instagram"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path></svg
            >
          </a>
          <a
            href="mailto:support@kamomi.id"
            class="h-9 w-9 sm:h-10 sm:w-10 rounded-full bg-slate-900 hover:bg-[var(--color-primary-hover)] border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white transition-all transform hover:scale-110"
            title="Email"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Product Links -->
      <div class="space-y-3 sm:space-y-4">
        <h4 class="text-xs font-black text-white uppercase tracking-widest">
          Produk
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a
              href="/features"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Fitur Utama</a
            >
          </li>
          <li>
            <a
              href="/pricing"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Paket Harga</a
            >
          </li>
          <li>
            <a
              href="/guest"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Demo Tamu</a
            >
          </li>
          <li>
            <a
              href="/blog"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Blog & Edukasi</a
            >
          </li>
        </ul>
      </div>

      <!-- Resources -->
      <div class="space-y-3 sm:space-y-4">
        <h4 class="text-xs font-black text-white uppercase tracking-widest">
          Sumber Daya
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a
              href="/login"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Masuk Dashboard</a
            >
          </li>
          <li>
            <a
              href="/register"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Daftar Gratis</a
            >
          </li>
          <li>
            <a
              href="/faq"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Pusat Bantuan (FAQ)</a
            >
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div class="space-y-3 sm:space-y-4 col-span-2 sm:col-span-1 md:col-span-1">
        <h4 class="text-xs font-black text-white uppercase tracking-widest">
          Legal
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a
              href="/terms"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Syarat & Ketentuan</a
            >
          </li>
          <li>
            <a
              href="/privacy"
              class="text-xs text-slate-400 hover:text-emerald-400 transition-colors font-bold"
              >Kebijakan Privasi</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="relative z-10 border-t border-slate-800 mt-8 sm:mt-12 pt-6 sm:pt-8 flex flex-col sm:flex-row items-center justify-between text-center sm:text-left gap-3.5">
      <p class="text-[11px] sm:text-xs text-slate-500 font-semibold">
        © 2026 Kamomi.id. Platform Manajemen Hunian Digital.
      </p>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-[10px] sm:text-xs text-emerald-400 font-bold uppercase tracking-wider">System Operational</span>
      </div>
    </div>
  </div>
</footer>

