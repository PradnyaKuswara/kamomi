---

---

<footer
  class="bg-slate-900 text-slate-400 mt-auto border-t border-slate-800/80"
>
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-6 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1 space-y-4">
        <div class="flex items-center gap-2.5">
          <img src="/logo.png" alt="Kamomi" class="h-8 w-8 rounded-lg" />
          <span class="text-lg font-black tracking-tight text-white"
            >Kamomi<span class="text-cyan-500">.id</span></span
          >
        </div>
        <p class="text-xs text-slate-500 leading-relaxed max-w-xs">
          Platform manajemen hunian digital berbasis QR Code. Kelola kamar kost,
          homestay, dan villa dalam satu dashboard.
        </p>
        <div class="flex gap-3 pt-1">
          <a
            href="https://instagram.com/kamomi.id"
            target="_blank"
            rel="noopener noreferrer"
            class="h-8 w-8 rounded-lg bg-slate-800/60 hover:bg-cyan-600 flex items-center justify-center text-slate-500 hover:text-white transition-all"
            title="Instagram"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path></svg
            >
          </a>
          <a
            href="mailto:support@kamomi.id"
            class="h-8 w-8 rounded-lg bg-slate-800/60 hover:bg-cyan-600 flex items-center justify-center text-slate-500 hover:text-white transition-all"
            title="Email"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Product Links -->
      <div class="space-y-4">
        <h4 class="text-xs font-black text-slate-300 uppercase tracking-widest">
          Produk
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a
              href="/features"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Fitur Utama</a
            >
          </li>
          <li>
            <a
              href="/pricing"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Paket Harga</a
            >
          </li>
          <li>
            <a
              href="/guest"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Demo Tamu</a
            >
          </li>
          <li>
            <a
              href="/blog"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Blog & Edukasi</a
            >
          </li>
        </ul>
      </div>

      <!-- Resources -->
      <div class="space-y-4">
        <h4 class="text-xs font-black text-slate-300 uppercase tracking-widest">
          Sumber Daya
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a
              href="/login"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Masuk Dashboard</a
            >
          </li>
          <li>
            <a
              href="/register"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Daftar Gratis</a
            >
          </li>
          <li>
            <a
              href="/dashboard/faq"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Pusat Bantuan</a
            >
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div class="space-y-4">
        <h4 class="text-xs font-black text-slate-300 uppercase tracking-widest">
          Legal
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a
              href="/terms"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Syarat & Ketentuan</a
            >
          </li>
          <li>
            <a
              href="/privacy"
              class="text-xs text-slate-500 hover:text-white transition-colors font-medium"
              >Kebijakan Privasi</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-slate-600/60">
    <div
      class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3"
    >
      <p class="text-[11px] text-slate-600">
        © 2026 Kamomi.id. All rights reserved.
      </p>
    </div>
  </div>
</footer>
