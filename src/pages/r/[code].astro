---
import GuestRoomPublic from '../../components/guest/GuestRoomPublic.tsx';
import '../../styles/global.css';

export const prerender = false;

const { code } = Astro.params;
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Guestbook Kamar - Kamomi.id</title>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <style>
      .phone-frame::-webkit-scrollbar {
        width: 3px;
      }
      .phone-frame::-webkit-scrollbar-track {
        background: transparent;
      }
      .phone-frame::-webkit-scrollbar-thumb {
        background: rgba(156, 163, 175, 0.3);
        border-radius: 99px;
      }
    </style>
  </head>
  <body class="bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300">

    <main class="flex-1 flex flex-col items-center justify-center p-4 py-8 gap-6">
      <a href="/" class="flex items-center gap-2 group no-underline">
        <img
          src="/logo.png"
          alt="Kamomi Logo"
          class="h-9 w-9 object-contain rounded-xl shadow-md group-hover:scale-105 transition-transform"
        />
        <span class="text-xl font-extrabold tracking-tight text-cyan-600 dark:text-cyan-400">
          Kamomi
          <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 ml-0.5">
            .id
          </span>
        </span>
      </a>

      {/* Phone container on desktop, clean layout on mobile */}
      <div class="phone-frame w-full max-w-md md:border-10 md:border-slate-900 md:dark:border-slate-800 md:rounded-[48px] md:shadow-2xl md:bg-white md:dark:bg-slate-900/60 md:h-195 md:overflow-y-auto relative md:p-6 md:pb-12 md:backdrop-blur-md">
        
        {/* Mock Speaker/Camera Notch on Desktop */}
        <div class="hidden md:block absolute top-3 left-1/2 -translate-x-1/2 w-32 h-5 bg-slate-900 dark:bg-slate-800 rounded-full z-30"></div>

        <div class="md:pt-6">
          <GuestRoomPublic code={code || ""} client:only="react" />
        </div>
        
        {/* Mock Home Indicator Bar on Desktop */}
        <div class="hidden md:block absolute bottom-2.5 left-1/2 -translate-x-1/2 w-32 h-1 bg-slate-400 dark:bg-slate-700 rounded-full z-30"></div>
      </div>
    </main>
  </body>
</html>
