---
import Navbar from "../components/Navbar.tsx";
import "../styles/global.css";
import type { SubscriptionPlan } from "../types/subscription-plan";
import { formatCurrency } from "../utils/formatCurrency";
import { parseFeatures } from "../utils/helper";

let plans: SubscriptionPlan[] = [];
let fetchError = false;

const BASE_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";

try {
  const response = await fetch(`${BASE_URL}/api/subscription-plans/active`);
  if (response.ok) {
    const json = await response.json();
    if (json.success && Array.isArray(json.data)) {
      plans = json.data;
    }
  } else {
    fetchError = true;
  }
} catch (e) {
  fetchError = true;
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Harga - Kamomi.id</title>
    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (
        theme === "dark" ||
        (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body
    class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased scroll-smooth"
  >
    <Navbar client:load />

    <main class="flex-1 pt-32 pb-20 px-4">
      <div class="max-w-7xl mx-auto space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-400 border border-cyan-200/30"
          >
            🏷️ Paket Layanan
          </span>
          <h1
            class="text-4xl font-black text-slate-800 dark:text-white tracking-tight"
          >
            Paket Harga Sederhana untuk Semua Bisnis Properti
          </h1>
          <p class="text-sm text-slate-400 dark:text-slate-500">
            Mulai gratis lalu tingkatkan fitur sesuai kebutuhan kamar Anda
          </p>
        </div>

        {
          /* Dynamic Subscription Plans rendered directly by Astro (SSR / Build time) */
        }
        {
          fetchError && plans.length === 0 ? (
            <div class="text-center text-red-500 py-10 bg-red-50 dark:bg-red-950/20 rounded-2xl p-6 border border-red-200/50">
              <p class="font-semibold text-sm">
                Gagal memuat daftar paket langganan dari server.
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
              {plans.map((plan) => {
                const isFeatured =
                  plan.name.toLowerCase().includes("pro") ||
                  plan.name.toLowerCase().includes("starter");
                const featureList = parseFeatures(plan.features);

                return (
                  <div
                    class={`glassmorphic rounded-3xl p-6 border shadow-lg flex flex-col justify-between relative overflow-hidden transition-all duration-300 hover:scale-[1.02] ${
                      isFeatured
                        ? "border-2 border-cyan-500 dark:border-cyan-400 glow-card"
                        : "border-slate-200/50 dark:border-slate-800/50"
                    }`}
                  >
                    {isFeatured && (
                      <div class="absolute top-0 right-0 px-3 py-1 bg-cyan-500 text-slate-950 text-[9px] font-black uppercase rounded-bl-xl tracking-wider">
                        Terpopuler
                      </div>
                    )}

                    <div class="space-y-4">
                      <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider block">
                        {plan.name}
                      </span>
                      <h3 class="text-xl font-black text-slate-800 dark:text-white">
                        {plan.name}
                      </h3>
                      <p class="text-[11px] text-slate-400 dark:text-slate-500 min-h-[32px]">
                        {plan.description || `Paket berlangganan ${plan.name}`}
                      </p>

                      <div class="text-2xl font-black text-slate-800 dark:text-white mt-4">
                        {formatCurrency(plan.price)}
                        {plan.price > 0 && (
                          <span class="text-xs text-slate-400 font-semibold">
                            /
                            {plan.billingCycle?.toLowerCase() === "monthly"
                              ? "bulan"
                              : plan.billingCycle?.toLowerCase()}
                          </span>
                        )}
                      </div>

                      <ul class="space-y-3 pt-6 text-xs text-slate-500 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800/50">
                        {featureList.map((feat) => (
                          <li class="flex items-start gap-2">
                            <svg
                              class="h-4 w-4 text-cyan-500 shrink-0 mt-0.5"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"
                              />
                            </svg>
                            <span>{feat}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <a
                      href="/register"
                      class={`w-full mt-8 py-3 text-center rounded-xl font-bold text-xs transition-all block ${
                        isFeatured
                          ? "bg-cyan-600 text-white hover:opacity-90 shadow-md shadow-cyan-500/10"
                          : "border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-900"
                      }`}
                    >
                      {plan.price === 0 ? "Mulai Sekarang" : "Pilih Paket"}
                    </a>
                  </div>
                );
              })}
            </div>
          )
        }

        {/* Add-ons & Extra Services */}
        <div
          class="max-w-4xl mx-auto space-y-6 pt-12 border-t border-slate-200/50 dark:border-slate-800/50"
        >
          <div class="text-center space-y-1">
            <h3 class="text-xl font-bold text-slate-800 dark:text-white">
              Layanan Tambahan & Cetak Fisik
            </h3>
            <p class="text-xs text-slate-400 dark:text-slate-500">
              Optimalkan operasional penginapan Anda dengan layanan penunjang
              kami
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {/* Physical Print Service */}
            <div
              class="p-6 rounded-2xl bg-white dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 flex flex-col justify-between"
            >
              <div class="space-y-2">
                <span
                  class="text-[9px] font-black uppercase text-amber-600 dark:text-amber-400 bg-amber-100 dark:bg-amber-950/40 px-2.5 py-0.5 rounded-full inline-block"
                  >Cetak Fisik</span
                >
                <h4
                  class="font-extrabold text-sm text-slate-800 dark:text-white"
                >
                  Paket Cetak Akrilik Pintu (A6)
                </h4>
                <p
                  class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed"
                >
                  Malas mencetak sendiri? Kami cetakkan stiker QR anti-air
                  berkualitas tinggi dengan stand akrilik bening A6 mewah,
                  dikirim langsung ke properti Anda.
                </p>
              </div>
              <div
                class="flex justify-between items-center pt-4 border-t border-slate-100 dark:border-slate-800/50 mt-4"
              >
                <span
                  class="text-xs font-bold text-slate-700 dark:text-slate-300"
                  >Mulai Rp 25.000 <span
                    class="text-[10px] text-slate-400 font-normal">/kamar</span
                  ></span
                >
                <a
                  href="https://wa.me/6281234567890?text=Halo%20Kamomi%20saya%20tertarik%20pesan%20cetak%20fisik%20akrilik"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-bold text-cyan-600 hover:underline"
                  >Pesan via WA →</a
                >
              </div>
            </div>

            {/* WA Notification Add-on */}
            <div
              class="p-6 rounded-2xl bg-white dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 flex flex-col justify-between"
            >
              <div class="space-y-2">
                <span
                  class="text-[9px] font-black uppercase text-emerald-600 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-950/40 px-2.5 py-0.5 rounded-full inline-block"
                  >Integrasi Sistem</span
                >
                <h4
                  class="font-extrabold text-sm text-slate-800 dark:text-white"
                >
                  Notifikasi Keluhan Instant WhatsApp
                </h4>
                <p
                  class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed"
                >
                  Kirim laporan kerusakan atau keluhan yang diisi tamu secara
                  real-time langsung ke WhatsApp pengelola/staf penjaga tanpa
                  perlu mengecek dashboard.
                </p>
              </div>
              <div
                class="flex justify-between items-center pt-4 border-t border-slate-100 dark:border-slate-800/50 mt-4"
              >
                <span
                  class="text-xs font-bold text-slate-700 dark:text-slate-300"
                  >+ Rp 15.000 <span
                    class="text-[10px] text-slate-400 font-normal">/bulan</span
                  ></span
                >
                <span class="text-[10px] text-slate-400 font-bold"
                  >Tersedia di Dashboard</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    {/* Footer */}
    <footer
      class="bg-slate-900 text-slate-400 py-12 px-4 border-t border-slate-800 mt-auto"
    >
      <div
        class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6"
      >
        <div class="flex items-center gap-2">
          <span class="text-lg font-extrabold tracking-tight text-white"
            >Kamomi<span class="text-xs text-slate-500 font-semibold">.id</span
            ></span
          >
        </div>
        <p class="text-xs text-slate-500">
          © 2026 Kamomi.id. All rights reserved. Slogan: "Asisten Pintar Kamar
          Kamu"
        </p>
        <div class="flex gap-4">
          <a
            href="/terms"
            class="text-xs text-slate-500 hover:text-white transition-colors"
            >Syarat & Ketentuan</a
          >
          <a
            href="/privacy"
            class="text-xs text-slate-500 hover:text-white transition-colors"
            >Kebijakan Privasi</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
