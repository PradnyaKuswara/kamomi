---
import Navbar from "../components/layout/Navbar.tsx";
import "../styles/global.css";
import type { SubscriptionPlan } from "../types/subscription-plan";
import { formatCurrency } from "../utils/formatCurrency";
import { parseFeatures } from "../utils/helper";

let plans: SubscriptionPlan[] = [];
let fetchError = false;

const BASE_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";

try {
  const response = await fetch(`${BASE_URL}/api/subscription-plans/active`);
  if (response.ok) {
    const json = await response.json();
    if (json.success && Array.isArray(json.data)) {
      plans = json.data;
    }
  } else {
    fetchError = true;
  }
} catch (e) {
  fetchError = true;
}

const planStyles = [
  { accent: "slate", badge: false, gradient: "" },
  { accent: "cyan", badge: false, gradient: "" },
  { accent: "cyan", badge: true, gradient: "from-cyan-600 to-cyan-700" },
  { accent: "indigo", badge: false, gradient: "" },
];
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Harga - Kamomi.id</title>
    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (
        theme === "dark" ||
        (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body
    class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased scroll-smooth"
  >
    <Navbar client:load />

    <main class="flex-1 pt-28 pb-24 px-4">
      <!-- Hero Section -->
      <div class="max-w-4xl mx-auto text-center space-y-5 mb-16">
        <span
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-cyan-50 dark:bg-cyan-950/30 text-cyan-700 dark:text-cyan-400 border border-cyan-100 dark:border-cyan-900/40"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Paket & Harga
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-800 dark:text-white tracking-tight leading-[1.1]">
          Pilih Paket yang Tepat<br />
          <span class="text-cyan-600 dark:text-cyan-400">untuk Bisnis Anda</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
          Mulai gratis selamanya, lalu tingkatkan kapan saja. Semua paket sudah termasuk fitur inti Kamomi.
        </p>
      </div>

      <!-- Pricing Cards -->
      {
        fetchError && plans.length === 0 ? (
          <div class="text-center text-red-500 py-10 bg-red-50 dark:bg-red-950/20 rounded-2xl p-6 border border-red-200/50 max-w-lg mx-auto">
            <p class="font-semibold text-sm">
              Gagal memuat daftar paket langganan dari server.
            </p>
          </div>
        ) : (
          <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
            {plans.map((plan, idx) => {
              const style = planStyles[idx] || planStyles[0];
              const isPro = plan.name.toLowerCase().includes("pro");
              const featureList = parseFeatures(plan.features);

              return isPro ? (
                /* ============= PRO / FEATURED CARD ============= */
                <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-cyan-600/10 lg:scale-[1.04] z-10">
                  {/* Glow border effect */}
                  <div class="absolute inset-0 rounded-3xl bg-linear-to-b from-cyan-500 to-cyan-700 p-[1.5px]">
                    <div class="h-full w-full rounded-3xl bg-slate-50 dark:bg-slate-950" />
                  </div>

                  <div class="relative p-6 flex flex-col justify-between h-full">
                    {/* Badge */}
                    <div class="absolute top-0 right-0 px-4 py-1.5 bg-cyan-600 text-white text-[9px] font-black uppercase rounded-bl-2xl tracking-widest">
                      Paling Populer
                    </div>

                    <div class="space-y-5">
                      <div>
                        <span class="text-[10px] font-black text-cyan-600 dark:text-cyan-400 uppercase tracking-widest">{plan.name}</span>
                        <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">{plan.name}</h3>
                        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1 min-h-7 leading-relaxed">
                          {plan.description || `Paket berlangganan ${plan.name}`}
                        </p>
                      </div>

                      <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-black text-slate-800 dark:text-white">{formatCurrency(plan.price)}</span>
                        {plan.price > 0 && (
                          <span class="text-xs text-slate-400 font-semibold">
                            /{plan.billingCycle?.toLowerCase() === "monthly" ? "bulan" : plan.billingCycle?.toLowerCase()}
                          </span>
                        )}
                      </div>

                      <ul class="space-y-2.5 pt-5 border-t border-slate-200/60 dark:border-slate-800/60">
                        {featureList.map((feat) => (
                          <li class="flex items-start gap-2.5 text-xs text-slate-600 dark:text-slate-300">
                            <div class="h-4.5 w-4.5 rounded-full bg-cyan-100 dark:bg-cyan-950/40 flex items-center justify-center shrink-0 mt-0.5">
                              <svg class="h-3 w-3 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                            </div>
                            <span class="font-medium">{feat}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <a
                      href="/register"
                      class="w-full mt-8 py-3.5 text-center rounded-xl font-bold text-sm bg-cyan-600 text-white hover:bg-cyan-500 transition-all block shadow-lg shadow-cyan-600/15 active:scale-[0.98]"
                    >
                      Pilih Paket
                    </a>
                  </div>
                </div>
              ) : (
                /* ============= NORMAL CARD ============= */
                <div class="rounded-3xl p-6 bg-white dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
                  <div class="space-y-5">
                    <div>
                      <span class="text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">{plan.name}</span>
                      <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">{plan.name}</h3>
                      <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1 min-h-7 leading-relaxed">
                        {plan.description || `Paket berlangganan ${plan.name}`}
                      </p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <span class="text-3xl font-black text-slate-800 dark:text-white">{formatCurrency(plan.price)}</span>
                      {plan.price > 0 && (
                        <span class="text-xs text-slate-400 font-semibold">
                          /{plan.billingCycle?.toLowerCase() === "monthly" ? "bulan" : plan.billingCycle?.toLowerCase()}
                        </span>
                      )}
                    </div>

                    <ul class="space-y-2.5 pt-5 border-t border-slate-100 dark:border-slate-800/50">
                      {featureList.map((feat) => (
                        <li class="flex items-start gap-2.5 text-xs text-slate-500 dark:text-slate-400">
                          <div class="h-4.5 w-4.5 rounded-full bg-slate-100 dark:bg-slate-800/60 flex items-center justify-center shrink-0 mt-0.5">
                            <svg class="h-3 w-3 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                          </div>
                          <span class="font-medium">{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <a
                    href="/register"
                    class={`w-full mt-8 py-3.5 text-center rounded-xl font-bold text-sm transition-all block active:scale-[0.98] ${
                      plan.price === 0
                        ? "bg-slate-800 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-700 dark:hover:bg-slate-100"
                        : "border-2 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-cyan-500 hover:text-cyan-600 dark:hover:border-cyan-500 dark:hover:text-cyan-400"
                    }`}
                  >
                    {plan.price === 0 ? "Mulai Gratis" : "Pilih Paket"}
                  </a>
                </div>
              );
            })}
          </div>
        )
      }

      <!-- FAQ Teaser Section -->
      <div class="max-w-3xl mx-auto mt-20 text-center space-y-4">
        <h2 class="text-xl font-black text-slate-800 dark:text-white">Masih punya pertanyaan?</h2>
        <p class="text-sm text-slate-400">
          Baca halaman FAQ atau langsung hubungi tim kami untuk konsultasi gratis.
        </p>
        <div class="flex justify-center gap-3 pt-2">
          <a
            href="/features"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-cyan-500 hover:text-cyan-600 transition-all"
          >
            Lihat Semua Fitur
          </a>
          <a
            href="/register"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-cyan-600 text-white hover:bg-cyan-500 transition-all shadow-md shadow-cyan-600/10"
          >
            Daftar Gratis Sekarang
          </a>
        </div>
      </div>
    </main>

    {/* Footer */}
    <footer
      class="bg-slate-900 text-slate-400 py-12 px-4 border-t border-slate-800 mt-auto"
    >
      <div
        class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6"
      >
        <div class="flex items-center gap-2">
          <span class="text-lg font-extrabold tracking-tight text-white"
            >Kamomi<span class="text-xs text-slate-500 font-semibold">.id</span
            ></span
          >
        </div>
        <p class="text-xs text-slate-500">
          © 2026 Kamomi.id. All rights reserved
        </p>
        <div class="flex gap-4">
          <a
            href="/terms"
            class="text-xs text-slate-500 hover:text-white transition-colors"
            >Syarat & Ketentuan</a
          >
          <a
            href="/privacy"
            class="text-xs text-slate-500 hover:text-white transition-colors"
            >Kebijakan Privasi</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
