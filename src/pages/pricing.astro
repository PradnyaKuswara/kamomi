---
import Navbar from '../components/Navbar.jsx';
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Harga - Kamomi.id</title>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased scroll-smooth">
    <Navbar client:load />

    <main class="flex-1 pt-32 pb-20 px-4">
      <div class="max-w-7xl mx-auto space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-400 border border-cyan-200/30">
            🏷️ Paket Layanan
          </span>
          <h1 class="text-4xl font-black text-slate-800 dark:text-white tracking-tight">
            Paket Harga Sederhana untuk Semua Bisnis Properti
          </h1>
          <p class="text-sm text-slate-400 dark:text-slate-500">
            Mulai gratis lalu tingkatkan fitur sesuai kebutuhan kamar Anda
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {/* Free Plan */}
          <div class="glassmorphic rounded-3xl p-6 border border-slate-200/50 dark:border-slate-800/50 shadow-lg flex flex-col justify-between">
            <div class="space-y-4">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Starter Pack</span>
              <h3 class="text-xl font-black text-slate-800 dark:text-white">Gratis Selamanya</h3>
              <p class="text-[11px] text-slate-400 dark:text-slate-500">Cocok untuk pemilik kost kecil atau homestay dengan 1-3 kamar.</p>
              
              <div class="text-2xl font-black text-slate-800 dark:text-white mt-4">Rp 0</div>
              
              <ul class="space-y-3 pt-6 text-xs text-slate-500 dark:text-slate-400">
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Maksimal 3 Kamar Aktif
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Desain Kartu QR Standar
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Aturan & WiFi Info Dasar
                </li>
              </ul>
            </div>
            
            <a 
              href="/register" 
              class="w-full mt-8 py-3 text-center rounded-xl font-bold text-xs border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-900 transition-all block"
            >
              Mulai Sekarang
            </a>
          </div>

          {/* Pro Host - Tier 1 */}
          <div class="glassmorphic rounded-3xl p-6 border-2 border-cyan-500 dark:border-cyan-400 shadow-xl flex flex-col justify-between glow-card relative overflow-hidden">
            <div class="absolute top-0 right-0 px-3 py-1 bg-cyan-500 text-slate-950 text-[9px] font-black uppercase rounded-bl-xl tracking-wider">Terpopuler</div>

            <div class="space-y-4">
              <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider block">Pro Host</span>
              <h3 class="text-xl font-black text-slate-800 dark:text-white">Kamomi Pro</h3>
              <p class="text-[11px] text-slate-400 dark:text-slate-500">Pilihan terbaik untuk pengelola Kost Menengah & Homestay aktif.</p>
              
              <div class="text-2xl font-black text-slate-800 dark:text-white mt-4">Rp 29.000 <span class="text-xs text-slate-400 font-semibold">/bulan</span></div>
              
              <ul class="space-y-3 pt-6 text-xs text-slate-500 dark:text-slate-400">
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Maksimal 20 Kamar Aktif
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Branding Properti Sendiri (White Label)
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Sistem Laporan Keluhan Tamu
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Ekspor PDF Desain QR Berkualitas Tinggi
                </li>
              </ul>
            </div>
            
            <a 
              href="/register" 
              class="w-full mt-8 py-3 text-center rounded-xl font-bold text-xs bg-cyan-600 text-white hover:opacity-90 transition-all shadow-md shadow-cyan-500/10 block"
            >
              Langganan Pro
            </a>
          </div>

          {/* Enterprise - Tier 2 */}
          <div class="glassmorphic rounded-3xl p-6 border border-slate-200/50 dark:border-slate-800/50 shadow-lg flex flex-col justify-between">
            <div class="space-y-4">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Enterprise</span>
              <h3 class="text-xl font-black text-slate-800 dark:text-white">Kamomi Business</h3>
              <p class="text-[11px] text-slate-400 dark:text-slate-500">Untuk jaringan Kost Eksklusif, Cluster Kontrakan & Villa Resort.</p>
              
              <div class="text-2xl font-black text-slate-800 dark:text-white mt-4">Rp 99.000 <span class="text-xs text-slate-400 font-semibold">/bulan</span></div>
              
              <ul class="space-y-3 pt-6 text-xs text-slate-500 dark:text-slate-400">
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Kamar Aktif Tanpa Batas (Unlimited)
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Semua Fitur Kamomi Pro
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Integrasi WhatsApp Notifikasi Gratis
                </li>
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-cyan-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Multi-User Akun Staf/Penjaga Kost
                </li>
              </ul>
            </div>
            
            <a 
              href="/register" 
              class="w-full mt-8 py-3 text-center rounded-xl font-bold text-xs border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-900 transition-all block"
            >
              Hubungi Sales
            </a>
          </div>
        </div>

        {/* Add-ons & Extra Services */}
        <div class="max-w-4xl mx-auto space-y-6 pt-12 border-t border-slate-200/50 dark:border-slate-800/50">
          <div class="text-center space-y-1">
            <h3 class="text-xl font-bold text-slate-800 dark:text-white">Layanan Tambahan & Cetak Fisik</h3>
            <p class="text-xs text-slate-400 dark:text-slate-500">Optimalkan operasional penginapan Anda dengan layanan penunjang kami</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {/* Physical Print Service */}
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 flex flex-col justify-between">
              <div class="space-y-2">
                <span class="text-[9px] font-black uppercase text-amber-600 dark:text-amber-400 bg-amber-100 dark:bg-amber-950/40 px-2.5 py-0.5 rounded-full inline-block">Cetak Fisik</span>
                <h4 class="font-extrabold text-sm text-slate-800 dark:text-white">Paket Cetak Akrilik Pintu (A6)</h4>
                <p class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed">
                  Malas mencetak sendiri? Kami cetakkan stiker QR anti-air berkualitas tinggi dengan stand akrilik bening A6 mewah, dikirim langsung ke properti Anda.
                </p>
              </div>
              <div class="flex justify-between items-center pt-4 border-t border-slate-100 dark:border-slate-800/50 mt-4">
                <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Mulai Rp 25.000 <span class="text-[10px] text-slate-400 font-normal">/kamar</span></span>
                <a href="https://wa.me/6281234567890?text=Halo%20Kamomi%20saya%20tertarik%20pesan%20cetak%20fisik%20akrilik" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-cyan-600 hover:underline">Pesan via WA →</a>
              </div>
            </div>

            {/* WA Notification Add-on */}
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 flex flex-col justify-between">
              <div class="space-y-2">
                <span class="text-[9px] font-black uppercase text-emerald-600 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-950/40 px-2.5 py-0.5 rounded-full inline-block">Integrasi Sistem</span>
                <h4 class="font-extrabold text-sm text-slate-800 dark:text-white">Notifikasi Keluhan Instant WhatsApp</h4>
                <p class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed">
                  Kirim laporan kerusakan atau keluhan yang diisi tamu secara real-time langsung ke WhatsApp pengelola/staf penjaga tanpa perlu mengecek dashboard.
                </p>
              </div>
              <div class="flex justify-between items-center pt-4 border-t border-slate-100 dark:border-slate-800/50 mt-4">
                <span class="text-xs font-bold text-slate-700 dark:text-slate-300">+ Rp 15.000 <span class="text-[10px] text-slate-400 font-normal">/bulan</span></span>
                <span class="text-[10px] text-slate-400 font-bold">Tersedia di Dashboard</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    {/* Footer */}
    <footer class="bg-slate-900 text-slate-400 py-12 px-4 border-t border-slate-800 mt-auto">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-2">
          <span class="text-lg font-extrabold tracking-tight text-white">Kamomi<span class="text-xs text-slate-500 font-semibold">.id</span></span>
        </div>
        <p class="text-xs text-slate-500">© 2026 Kamomi.id. All rights reserved. Slogan: "Asisten Pintar Kamar Kamu"</p>
        <div class="flex gap-4">
          <a href="/terms" class="text-xs text-slate-500 hover:text-white transition-colors">Syarat & Ketentuan</a>
          <a href="/privacy" class="text-xs text-slate-500 hover:text-white transition-colors">Kebijakan Privasi</a>
        </div>
      </div>
    </footer>
  </body>
</html>
