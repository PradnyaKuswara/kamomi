---
import SEOHead from '../components/layout/SEOHead.astro';
import '../styles/global.css';
---

<html lang="id">
  <SEOHead
    title="Daftar Akun Gratis - Kamomi.id"
    description="Daftar akun Kamomi.id sekarang dan rasakan kemudahan mengelola properti sewa Anda dengan platform digital modern berbasis QR Code."
    keywords="daftar kamomi, buat akun kost, registrasi aplikasi kost"
  />
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen font-sans transition-colors duration-300">

    <div class="min-h-screen flex">
      <!-- Left Brand Panel -->
      <div class="hidden lg:flex lg:w-[52%] relative overflow-hidden bg-linear-to-br from-cyan-600 via-cyan-700 to-slate-900">
        <!-- Background decorative shapes -->
        <div class="absolute inset-0">
          <div class="absolute top-[-8%] left-[-5%] h-72 w-72 bg-white/5 rounded-full blur-3xl"></div>
          <div class="absolute bottom-[-10%] right-[-5%] h-80 w-80 bg-cyan-400/10 rounded-full blur-3xl"></div>
          <div class="absolute top-1/3 right-1/4 h-52 w-52 bg-white/3 rounded-full blur-2xl"></div>
          <!-- Subtle grid pattern -->
          <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
        </div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-between p-12 xl:p-16 w-full">
          <!-- Top: Logo -->
          <div class="flex items-center gap-3">
            <img src="/logo.png" alt="Kamomi" class="h-10 w-10 rounded-xl shadow-lg" />
            <span class="text-white font-black text-xl tracking-tight">Kamomi<span class="text-cyan-300">.id</span></span>
          </div>

          <!-- Center: Hero content -->
          <div class="flex-1 flex flex-col justify-center max-w-lg">
            <h2 class="text-4xl xl:text-5xl font-black text-white leading-[1.1] tracking-tight mb-6">
              Mulai kelola hunian Anda dalam
              <span class="text-cyan-300"> 3 detik</span>
            </h2>
            <p class="text-base text-cyan-100/80 leading-relaxed mb-10 font-medium">
              Cukup daftar dengan akun Google, lalu langsung setup properti, tambahkan kamar, dan cetak QR Card pintu pertama Anda. Tanpa setup ribet.
            </p>

            <!-- Steps -->
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <div class="h-9 w-9 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center text-cyan-300 font-black text-sm shrink-0">1</div>
                <div>
                  <p class="text-sm font-bold text-white">Daftar dengan Google</p>
                  <p class="text-xs text-cyan-100/50">Satu klik, tanpa form panjang</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="h-9 w-9 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center text-cyan-300 font-black text-sm shrink-0">2</div>
                <div>
                  <p class="text-sm font-bold text-white">Setup Properti & Kamar</p>
                  <p class="text-xs text-cyan-100/50">Wizard intuitif langsung setelah login</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="h-9 w-9 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center text-cyan-300 font-black text-sm shrink-0">3</div>
                <div>
                  <p class="text-sm font-bold text-white">Cetak QR Card Premium</p>
                  <p class="text-xs text-cyan-100/50">Desain siap cetak untuk dudukan akrilik pintu</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom: Trust indicator -->
          <div class="border-t border-white/10 pt-6">
            <div class="flex items-center gap-6">
              <div class="flex -space-x-2">
                <div class="h-8 w-8 rounded-full bg-cyan-500/40 border-2 border-cyan-700 flex items-center justify-center text-white text-[10px] font-bold">IA</div>
                <div class="h-8 w-8 rounded-full bg-emerald-500/40 border-2 border-cyan-700 flex items-center justify-center text-white text-[10px] font-bold">BP</div>
                <div class="h-8 w-8 rounded-full bg-indigo-500/40 border-2 border-cyan-700 flex items-center justify-center text-white text-[10px] font-bold">RS</div>
              </div>
              <div>
                <p class="text-xs font-bold text-white">Dipercaya 500+ pengelola hunian</p>
                <p class="text-[10px] text-cyan-200/50">di seluruh Indonesia</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Form Panel -->
      <div class="flex-1 flex flex-col justify-center items-center px-6 py-12 lg:px-16 xl:px-24 relative">
        <!-- Background decorative -->
        <div class="absolute top-16 right-16 h-48 w-48 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-16 left-16 h-32 w-32 bg-slate-500/5 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Mobile logo (shown on small screens only) -->
        <div class="flex lg:hidden items-center gap-3 mb-10">
          <img src="/logo.png" alt="Kamomi" class="h-9 w-9 rounded-xl shadow-md" />
          <span class="font-black text-lg text-slate-800 dark:text-white tracking-tight">Kamomi<span class="text-cyan-600 dark:text-cyan-400">.id</span></span>
        </div>

        <div class="w-full max-w-sm relative">
          <div class="mb-8">
            <h1 class="text-2xl font-black text-slate-800 dark:text-white tracking-tight">
              Buat Akun Baru
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 font-medium">
              Daftar gratis dan mulai kelola kamar kost atau homestay Anda secara instan.
            </p>
          </div>

          <!-- Google Register Button -->
          <button
            id="google-register-btn"
            type="button"
            class="w-full flex items-center justify-center gap-3 py-3.5 px-4 rounded-xl font-bold text-sm bg-cyan-600 text-white hover:bg-cyan-500 transition-all cursor-pointer shadow-lg shadow-cyan-600/15 active:scale-[0.98]"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="white" fill-opacity="0.8"></path>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="white" fill-opacity="0.9"></path>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="white" fill-opacity="0.7"></path>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="white" fill-opacity="0.85"></path>
            </svg>
            Daftar dengan Google
          </button>

          <!-- Benefits section -->
          <div class="mt-8 p-5 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200/60 dark:border-slate-800/60 space-y-3.5">
            <p class="text-xs font-extrabold text-slate-700 dark:text-slate-300">Yang Anda dapatkan:</p>
            <div class="space-y-2.5">
              <div class="flex items-center gap-2.5">
                <div class="h-5 w-5 rounded-md bg-cyan-50 dark:bg-cyan-950/30 flex items-center justify-center shrink-0">
                  <svg class="h-3 w-3 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Kelola hingga 3 kamar gratis selamanya</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="h-5 w-5 rounded-md bg-cyan-50 dark:bg-cyan-950/30 flex items-center justify-center shrink-0">
                  <svg class="h-3 w-3 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Cetak QR Card pintu premium</span>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="h-5 w-5 rounded-md bg-cyan-50 dark:bg-cyan-950/30 flex items-center justify-center shrink-0">
                  <svg class="h-3 w-3 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
                </div>
                <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Dashboard kelola tata tertib & info tamu</span>
              </div>
            </div>
          </div>

          <!-- Terms -->
          <p class="mt-5 text-[10px] text-center text-slate-400 dark:text-slate-500 leading-relaxed px-2">
            Dengan mendaftar, Anda menyetujui <a href="/terms" class="underline hover:text-cyan-500 font-semibold">Syarat & Ketentuan</a> dan <a href="/privacy" class="underline hover:text-cyan-500 font-semibold">Kebijakan Privasi</a> Kamomi.id.
          </p>

          <p class="mt-6 text-center text-xs text-slate-500 dark:text-slate-400">
            Sudah punya akun?
            <a href="/login" class="text-cyan-600 dark:text-cyan-400 font-bold hover:underline ml-1">Masuk disini</a>
          </p>
        </div>

        <!-- Footer -->
        <p class="absolute bottom-6 text-[10px] text-slate-400/60 font-medium">
          &copy; 2026 Kamomi.id &mdash; Platform Manajemen Hunian Digital
        </p>
      </div>
    </div>

    <script>
      const btn = document.getElementById('google-register-btn') as HTMLButtonElement;
      btn.addEventListener('click', () => {
        const backendUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
        window.location.href = `${backendUrl}/oauth2/authorization/google`;
      });
    </script>
  </body>
</html>
