---
import Navbar from '../components/Navbar.jsx';
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Daftar Akun - Kamomi.id</title>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300">
    <Navbar client:load />

    <main class="flex-1 flex items-center justify-center p-4 pt-24">
      <div class="w-full max-w-md p-8 rounded-3xl glassmorphic border border-slate-200/50 dark:border-slate-800/50 shadow-2xl relative overflow-hidden">
        {/* Decorative elements */}
        <div class="absolute -top-12 -left-12 h-24 w-24 bg-cyan-500/20 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-12 -right-12 h-24 w-24 bg-blue-500/20 rounded-full blur-2xl pointer-events-none"></div>

        <div class="text-center mb-8 relative">
          <h1 class="text-3xl font-extrabold text-cyan-600 dark:text-cyan-400">
            Buat Akun Kamomi
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Mulai kelola kamar kost atau homestay Anda secara digital & modern
          </p>
        </div>

        <form id="register-form" class="space-y-4 relative">
          <div class="space-y-1.5">
            <label for="name" class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Nama Lengkap</label>
            <input 
              type="text" 
              id="name" 
              required
              placeholder="Budi Santoso" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 text-slate-800 dark:text-white placeholder:text-slate-400 focus:outline-hidden focus:ring-2 focus:ring-cyan-500 transition-all text-sm"
            />
          </div>

          <div class="space-y-1.5">
            <label for="property" class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Nama Kost / Homestay</label>
            <input 
              type="text" 
              id="property" 
              required
              placeholder="Contoh: Kost Adem Tentrem / Kamomi Homestay" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 text-slate-800 dark:text-white placeholder:text-slate-400 focus:outline-hidden focus:ring-2 focus:ring-cyan-500 transition-all text-sm"
            />
          </div>

          <div class="space-y-1.5">
            <label for="email" class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Email</label>
            <input 
              type="email" 
              id="email" 
              required
              placeholder="budi@email.com" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 text-slate-800 dark:text-white placeholder:text-slate-400 focus:outline-hidden focus:ring-2 focus:ring-cyan-500 transition-all text-sm"
            />
          </div>

          <div class="space-y-1.5">
            <label for="password" class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Password</label>
            <input 
              type="password" 
              id="password" 
              required
              placeholder="Min. 8 karakter" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 text-slate-800 dark:text-white placeholder:text-slate-400 focus:outline-hidden focus:ring-2 focus:ring-cyan-500 transition-all text-sm"
            />
          </div>

          <button 
            type="submit" 
            class="w-full py-3 px-4 mt-2 rounded-xl font-bold text-sm bg-cyan-600 text-white hover:opacity-90 transition-all shadow-md shadow-cyan-500/10"
          >
            Daftar Sekarang
          </button>
        </form>

        <div class="mt-6 text-center text-xs text-slate-500 dark:text-slate-400">
          Sudah punya akun? <a href="/login" class="text-cyan-600 dark:text-cyan-400 font-semibold hover:underline">Masuk disini</a>
        </div>
      </div>
    </main>

    <script is:inline>
      const form = document.getElementById('register-form');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('name').value;
        const property = document.getElementById('property').value;
        
        // Save to local storage for simulation
        localStorage.setItem('user_logged_in', 'true');
        localStorage.setItem('owner_name', name);
        localStorage.setItem('property_name', property);
        window.location.href = '/dashboard';
      });
    </script>
  </body>
</html>
