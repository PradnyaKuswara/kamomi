---
import Navbar from "../components/layout/Navbar.tsx";
import Footer from "../components/layout/Footer.astro";
import SEOHead from "../components/layout/SEOHead.astro";
import DashboardShowcase from "../components/public/DashboardShowcase.tsx";
import "../styles/global.css";
---

<html lang="id">
  <SEOHead
    title="Fitur Lengkap - Kamomi.id"
    description="Jelajahi berbagai fitur unggulan Kamomi.id: Buku Tamu Digital QR, Keluhan Kamar, Tata Tertib & Panduan Fasilitas, serta Manajemen Staff."
    keywords="fitur kamomi, buku tamu digital, qr kamar kost, manajemen keluhan kost, tata tertib kost digital"
  />
  <body
    class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased scroll-smooth"
  >
    <Navbar client:load />

    <main class="flex-1 pt-28 pb-24 px-4">
      <!-- Hero Section -->
      <div class="max-w-4xl mx-auto text-center space-y-5 mb-20">
        <span
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-cyan-50 dark:bg-cyan-950/30 text-cyan-700 dark:text-cyan-400 border border-cyan-100 dark:border-cyan-900/40"
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
          >
          Fitur Utama
        </span>
        <h1
          class="text-4xl sm:text-5xl font-black text-slate-800 dark:text-white tracking-tight leading-[1.1]"
        >
          Semua yang Anda Butuhkan<br />
          <span class="text-cyan-600 dark:text-cyan-400"
            >dalam Satu Platform</span
          >
        </h1>
        <p
          class="text-sm sm:text-base text-slate-500 dark:text-slate-400 max-w-xl mx-auto leading-relaxed"
        >
          Dari pembuatan QR Card premium hingga manajemen keluhan tamu — Kamomi
          dirancang untuk menyederhanakan operasional hunian Anda.
        </p>
      </div>

      <!-- Feature Grid: 6 Features -->
      <div
        class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        <!-- Feature 1: QR Code -->
        <div
          class="group relative rounded-3xl p-7 bg-white dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 h-28 w-28 bg-cyan-500/4 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl group-hover:bg-cyan-500/8 transition-all"
          >
          </div>
          <div
            class="h-12 w-12 rounded-2xl bg-cyan-50 dark:bg-cyan-950/40 border border-cyan-100 dark:border-cyan-900/40 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-5"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6.75 6.75h.75v.75h-.75v-.75zM6.75 16.5h.75v.75h-.75v-.75zM16.5 6.75h.75v.75h-.75v-.75zM13.5 13.5h.75v.75h-.75v-.75zM13.5 19.5h.75v.75h-.75v-.75zM19.5 13.5h.75v.75h-.75v-.75zM19.5 19.5h.75v.75h-.75v-.75zM16.5 16.5h.75v.75h-.75v-.75z"
              ></path>
            </svg>
          </div>
          <h3
            class="font-extrabold text-slate-800 dark:text-white text-lg mb-2 tracking-tight"
          >
            QR Card Pintu Kamar
          </h3>
          <p class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed">
            Buat dan ekspor kartu desain QR code unik untuk setiap kamar. Cetak
            dalam bentuk stiker atau papan akrilik premium A6 untuk ditempel di
            pintu kamar.
          </p>
          <div
            class="mt-5 flex items-center gap-1.5 text-[10px] font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider"
          >
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
            Cetak siap pakai
          </div>
        </div>

        <!-- Feature 2: Wi-Fi Instan -->
        <div
          class="group relative rounded-3xl p-7 bg-white dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 h-28 w-28 bg-emerald-500/4 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl group-hover:bg-emerald-500/8 transition-all"
          >
          </div>
          <div
            class="h-12 w-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-100 dark:border-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-5"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"
              ></path>
            </svg>
          </div>
          <h3
            class="font-extrabold text-slate-800 dark:text-white text-lg mb-2 tracking-tight"
          >
            Koneksi Wi-Fi Instan
          </h3>
          <p class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed">
            Tamu tidak perlu repot mengetik password WiFi yang panjang. Cukup
            tekan tombol salin atau scan QR untuk terhubung otomatis ke internet
            hunian.
          </p>
          <div
            class="mt-5 flex items-center gap-1.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider"
          >
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
            Satu klik salin
          </div>
        </div>

        <!-- Feature 3: Tata Tertib -->
        <div
          class="group relative rounded-3xl p-7 bg-white dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 h-28 w-28 bg-indigo-500/4 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl group-hover:bg-indigo-500/8 transition-all"
          >
          </div>
          <div
            class="h-12 w-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-5"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
              ></path>
            </svg>
          </div>
          <h3
            class="font-extrabold text-slate-800 dark:text-white text-lg mb-2 tracking-tight"
          >
            Tata Tertib Interaktif
          </h3>
          <p class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed">
            Hadirkan aturan kamar secara digital. Ubah kapan saja lewat
            dashboard tanpa mencetak ulang kertas — tamu selalu melihat versi
            terbaru.
          </p>
          <div
            class="mt-5 flex items-center gap-1.5 text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider"
          >
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
            Realtime update
          </div>
        </div>

        <!-- Feature 4: Dashboard Pengelola -->
        <div
          class="group relative rounded-3xl p-7 bg-white dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 h-28 w-28 bg-violet-500/4 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl group-hover:bg-violet-500/8 transition-all"
          >
          </div>
          <div
            class="h-12 w-12 rounded-2xl bg-violet-50 dark:bg-violet-950/40 border border-violet-100 dark:border-violet-900/40 text-violet-600 dark:text-violet-400 flex items-center justify-center mb-5"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
              ></path>
            </svg>
          </div>
          <h3
            class="font-extrabold text-slate-800 dark:text-white text-lg mb-2 tracking-tight"
          >
            Dashboard Pengelola
          </h3>
          <p class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed">
            Pantau seluruh kamar, kelola staff, dan atur tata tertib dari satu
            dashboard yang intuitif. Statistik penting langsung terlihat di
            halaman utama.
          </p>
          <div
            class="mt-5 flex items-center gap-1.5 text-[10px] font-bold text-violet-600 dark:text-violet-400 uppercase tracking-wider"
          >
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
            All-in-one view
          </div>
        </div>

        <!-- Feature 5: Keluhan Tamu -->
        <div
          class="group relative rounded-3xl p-7 bg-white dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 h-28 w-28 bg-rose-500/4 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl group-hover:bg-rose-500/8 transition-all"
          >
          </div>
          <div
            class="h-12 w-12 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-100 dark:border-rose-900/40 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-5"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
              ></path>
            </svg>
          </div>
          <h3
            class="font-extrabold text-slate-800 dark:text-white text-lg mb-2 tracking-tight"
          >
            Lapor Keluhan Tamu
          </h3>
          <p class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed">
            Tamu dapat langsung melaporkan kendala (AC rusak, air mati) melalui
            portal digital. Notifikasi masuk ke dashboard pengelola secara
            instan.
          </p>
          <div
            class="mt-5 flex items-center gap-1.5 text-[10px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider"
          >
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
            Tanpa chat manual
          </div>
        </div>

        <!-- Feature 6: Manajemen Staff -->
        <div
          class="group relative rounded-3xl p-7 bg-white dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 h-28 w-28 bg-amber-500/4 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl group-hover:bg-amber-500/8 transition-all"
          >
          </div>
          <div
            class="h-12 w-12 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-100 dark:border-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-5"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"
              ></path>
            </svg>
          </div>
          <h3
            class="font-extrabold text-slate-800 dark:text-white text-lg mb-2 tracking-tight"
          >
            Manajemen Staff
          </h3>
          <p class="text-xs text-slate-400 dark:text-slate-500 leading-relaxed">
            Tambahkan staff dengan peran berbeda (Admin / User). Tugaskan kamar
            spesifik ke setiap staff untuk pembagian kerja yang jelas.
          </p>
          <div
            class="mt-5 flex items-center gap-1.5 text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider"
          >
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
            Role-based access
          </div>
        </div>
      </div>

      <!-- Dashboard Management Interactive Showcase -->
      <DashboardShowcase client:load />

      <!-- CTA Section -->
      <!-- <div class="max-w-3xl mx-auto mt-20 relative">
        <div class="absolute inset-0 bg-cyan-600/[0.03] rounded-3xl blur-2xl"></div>
        <div class="relative rounded-3xl bg-white dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60 p-10 sm:p-14 text-center space-y-5 shadow-sm">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-800 dark:text-white tracking-tight">
            Siap Digitalisasi Hunian Anda?
          </h2>
          <p class="text-sm text-slate-400 max-w-md mx-auto leading-relaxed">
            Daftar gratis sekarang dan cetak QR Card pintu pertama Anda dalam hitungan menit. Tanpa kartu kredit.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-3 pt-2">
            <a
              href="/pricing"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-bold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-cyan-500 hover:text-cyan-600 transition-all"
            >
              Lihat Harga Paket
            </a>
            <a
              href="/register"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-cyan-600 text-white hover:bg-cyan-500 transition-all shadow-lg shadow-cyan-600/15 active:scale-[0.98]"
            >
              Mulai Gratis Sekarang
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>
        </div>
      </div> -->
    </main>

    <Footer />
  </body>
</html>
