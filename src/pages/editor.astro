---
import DashboardLayout from '../components/dashboard/layout/DashboardLayout.tsx';
import RoomEditor from '../components/dashboard/view/RoomEditor.tsx';
import SEOHead from '../components/layout/SEOHead.astro';
import '../styles/global.css';
---

<html lang="id">
  <SEOHead
    title="Edit Kamar & Desain QR - Kamomi.id"
    description="Kustomisasi tampilan kamar dan cetak QR Code unik untuk setiap kamar hunian Anda dengan editor modern Kamomi.id."
    keywords="editor qr code, cetak qr kamar, desain qr kost"
    noindex={true}
  />
  <body class="bg-[var(--bg-subtle)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans transition-colors duration-300">
    
    <script is:inline>
      if (localStorage.getItem('user_logged_in') !== 'true') {
        window.location.href = '/login';
      }
    </script>

    <DashboardLayout client:only="react" activeMenu="rooms">
      <RoomEditor client:only="react" />
    </DashboardLayout>
  </body>
</html>

