---
import DashboardLayout from "../../components/dashboard/layout/DashboardLayout.tsx";
import RoomsList from "../../components/dashboard/view/RoomsList.tsx";
import SEOHead from "../../components/layout/SEOHead.astro";
import "../../styles/global.css";
---

<html lang="id">
  <SEOHead
    title="Kelola Kamar - Kamomi.id"
    description="Daftar dan manajemen kamar, pembuatan QR Code, serta status ketersediaan unit di dashboard Kamomi.id."
    noindex={true}
  />
  <body
    class="bg-[var(--bg-subtle)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans transition-colors duration-300"
  >
    <script is:inline>
      if (localStorage.getItem("user_logged_in") !== "true") {
        window.location.href = "/login";
      }
    </script>

    <DashboardLayout client:only="react" activeMenu="room">
      <RoomsList client:only="react" />
    </DashboardLayout>
  </body>
</html>
