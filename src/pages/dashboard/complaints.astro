---
import DashboardLayout from '../../components/dashboard/layout/DashboardLayout.tsx';
import ComplaintsTracker from '../../components/dashboard/view/ComplaintsTracker.tsx';
import SEOHead from '../../components/layout/SEOHead.astro';
import '../../styles/global.css';
---

<html lang="id">
  <SEOHead
    title="Keluhan Kamar - Kamomi.id"
    description="Pantau dan tangani keluhan atau laporan masalah dari penghuni kamar secara cepat di dashboard Kamomi.id."
    noindex={true}
  />
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300">
    
    <script is:inline>
      if (localStorage.getItem('user_logged_in') !== 'true') {
        window.location.href = '/login';
      }
    </script>

    <DashboardLayout client:only="react" activeMenu="complaints">
      <ComplaintsTracker client:only="react" />
    </DashboardLayout>

  </body>
</html>
