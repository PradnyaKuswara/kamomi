---
import DashboardLayout from '../../components/dashboard/layout/DashboardLayout.tsx';
import NotificationsList from '../../components/dashboard/view/NotificationsList.tsx';
import SEOHead from '../../components/layout/SEOHead.astro';
import '../../styles/global.css';
---

<html lang="id">
  <SEOHead
    title="Aktivitas Notifikasi - Kamomi.id"
    description="Lihat riwayat dan rincian notifikasi aktivitas di dashboard pengelola Kamomi.id."
    noindex={true}
  />
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300">
    
    <script is:inline>
      if (localStorage.getItem('user_logged_in') !== 'true') {
        window.location.href = '/login';
      }
    </script>

    <DashboardLayout client:only="react" activeMenu="aktivitasnotifikasi">
      <NotificationsList client:only="react" />
    </DashboardLayout>

  </body>
</html>
