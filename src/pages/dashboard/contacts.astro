---
import DashboardLayout from '../../components/dashboard/layout/DashboardLayout.tsx';
import ContactsList from '../../components/dashboard/view/ContactsList.tsx';
import '../../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/logo.png" as="image" />
    <meta name="viewport" content="width=device-width" />
    <title>Master Kontak - Kamomi.id</title>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300">
    
    <script is:inline>
      if (localStorage.getItem('user_logged_in') !== 'true') {
        window.location.href = '/login';
      }
    </script>

    <DashboardLayout client:only="react" activeMenu="contacts">
      <ContactsList client:only="react" />
    </DashboardLayout>

  </body>
</html>
