---
import DashboardLayout from '../../components/dashboard/layout/DashboardLayout.tsx';
import ContactsList from '../../components/dashboard/view/ContactsList.tsx';
import SEOHead from '../../components/layout/SEOHead.astro';
import '../../styles/global.css';
---

<html lang="id">
  <SEOHead
    title="Master Kontak - Kamomi.id"
    description="Kelola daftar kontak penting (Pengelola, Penjaga, Darurat) untuk penghuni di dashboard Kamomi.id."
    noindex={true}
  />
  <body class="bg-[var(--bg-subtle)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans transition-colors duration-300">
    
    <script is:inline>
      if (localStorage.getItem('user_logged_in') !== 'true') {
        window.location.href = '/login';
      }
    </script>

    <DashboardLayout client:only="react" activeMenu="contacts">
      <ContactsList client:only="react" />
    </DashboardLayout>

  </body>
</html>
