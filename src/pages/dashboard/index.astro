---
import DashboardLayout from '../../components/dashboard/layout/DashboardLayout.tsx';
import DashboardOverview from '../../components/dashboard/view/DashboardOverview.tsx';
import SEOHead from '../../components/layout/SEOHead.astro';
import '../../styles/global.css';
---

<html lang="id">
  <SEOHead
    title="Overview Dashboard - Kamomi.id"
    description="Ringkasan statistik, aktivitas terbaru, dan performa hunian Anda di dashboard pengelola Kamomi.id."
    noindex={true}
  />
  <body class="bg-[var(--bg-subtle)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans transition-colors duration-300">
    
    <script is:inline>
      if (localStorage.getItem('user_logged_in') !== 'true') {
        window.location.href = '/login';
      }
    </script>

    <DashboardLayout client:only="react" activeMenu="dashboard">
      <DashboardOverview client:only="react" />
    </DashboardLayout>

  </body>
</html>
