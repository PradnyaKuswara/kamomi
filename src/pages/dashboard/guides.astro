---
import DashboardLayout from '../../components/dashboard/layout/DashboardLayout.tsx';
import FacilityGuidesList from '../../components/dashboard/view/FacilityGuidesList.tsx';
import SEOHead from '../../components/layout/SEOHead.astro';
import '../../styles/global.css';
---

<html lang="id">
  <SEOHead
    title="Panduan Fasilitas - Kamomi.id"
    description="Kelola panduan penggunaan fasilitas kamar (Wi-Fi, AC, Water Heater) untuk penghuni di dashboard Kamomi.id."
    noindex={true}
  />
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300">
    
    <script is:inline>
      if (localStorage.getItem('user_logged_in') !== 'true') {
        window.location.href = '/login';
      }
    </script>

    <DashboardLayout client:only="react" activeMenu="panduanfasilitas">
      <FacilityGuidesList client:only="react" />
    </DashboardLayout>

  </body>
</html>
