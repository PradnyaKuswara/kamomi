---
import Logo from "../components/brand/Logo";
import LoginForm from "../components/auth/LoginForm";
import SEOHead from "../components/layout/SEOHead.astro";
import "../styles/global.css";
---

<html lang="id">
  <SEOHead
    title="Masuk - Kamomi.id"
    description="Masuk ke akun Kamomi.id Anda untuk mengelola kamar, melihat keluhan penghuni, dan memantau aktivitas hunian secara realtime."
    keywords="login kamomi, masuk akun kamomi, dashboard pengelola kost"
  />
  <body class="bg-[var(--bg-subtle)] text-[var(--text-primary)] min-h-screen font-sans transition-colors duration-300">

    <div class="min-h-screen flex">
      <!-- Left Brand Panel -->
      <div class="hidden lg:flex lg:w-[52%] relative overflow-hidden bg-linear-to-br from-cyan-600 via-cyan-700 to-slate-900">
        <!-- Background decorative shapes -->
        <div class="absolute inset-0">
          <div class="absolute top-[-8%] left-[-5%] h-72 w-72 bg-white/5 rounded-full blur-3xl"></div>
          <div class="absolute bottom-[-10%] right-[-5%] h-80 w-80 bg-cyan-400/10 rounded-full blur-3xl"></div>
          <div class="absolute top-1/2 left-1/3 h-40 w-40 bg-white/3 rounded-full blur-2xl"></div>
          <!-- Subtle grid pattern -->
          <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
        </div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-between p-12 xl:p-16 w-full">
          <!-- Top: Logo -->
          <Logo tone="light" markClassName="h-10 w-10" textClassName="text-xl" />

          <!-- Center: Hero content -->
          <div class="flex-1 flex flex-col justify-center max-w-lg">
            <h2 class="text-4xl xl:text-5xl font-black text-white leading-[1.1] tracking-tight mb-6">
              Kelola hunian Anda secara
              <span class="text-cyan-300"> digital & instan</span>
            </h2>
            <p class="text-base text-cyan-100/80 leading-relaxed mb-10 font-medium">
              Platform manajemen kost & homestay berbasis QR Code. Cetak kartu pintu kamar premium, kelola tata tertib, dan komunikasi tamu dalam satu dashboard.
            </p>

            <!-- Feature pills -->
            <div class="flex flex-wrap gap-2.5">
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10 text-sm text-white font-semibold">
                <svg class="h-4 w-4 text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                QR Card Pintu
              </span>
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10 text-sm text-white font-semibold">
                <svg class="h-4 w-4 text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                Dashboard Realtime
              </span>
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10 text-sm text-white font-semibold">
                <svg class="h-4 w-4 text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                Kelola Staff
              </span>
            </div>
          </div>

          <!-- Bottom: Testimonial quote -->
          <div class="border-t border-white/10 pt-6">
            <p class="text-sm text-cyan-100/60 italic leading-relaxed">
              "Setelah pakai Kamomi, operasional kost 30 kamar saya jadi jauh lebih rapi. Tamu juga senang karena bisa scan QR untuk lihat info kamar."
            </p>
            <div class="mt-3 flex items-center gap-3">
              <div class="h-8 w-8 rounded-full bg-cyan-500/30 flex items-center justify-center text-white text-xs font-bold">IA</div>
              <div>
                <p class="text-xs font-bold text-white">Ibu Anita</p>
                <p class="text-[10px] text-cyan-200/50">Pengelola Kost Mawar Residence</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Form Panel -->
      <div class="flex-1 flex flex-col justify-center items-center px-6 py-12 lg:px-16 xl:px-24 relative">
        <!-- Background decorative -->
        <div class="absolute top-12 right-12 h-48 w-48 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-12 left-12 h-32 w-32 bg-slate-500/5 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Mobile logo (shown on small screens only) -->
        <div class="flex lg:hidden mb-10"><Logo markClassName="h-9 w-9" textClassName="text-lg" /></div>

        <div class="w-full max-w-sm relative">
          <div class="mb-8">
            <h1 class="text-2xl font-black text-[var(--text-primary)] tracking-tight">
              Selamat Datang Kembali
            </h1>
            <p class="text-sm text-[var(--text-secondary)] mt-2 font-medium">
              Masuk untuk mengelola dashboard & cetak QR kamar Anda
            </p>
          </div>

          <LoginForm client:load />

          <p class="mt-8 text-center text-xs text-[var(--text-secondary)]">
            Belum punya akun?
            <a href="/register" class="text-cyan-600 dark:text-cyan-400 font-bold hover:underline ml-1">Daftar Sekarang</a>
          </p>
        </div>

        <!-- Footer -->
        <p class="absolute bottom-6 text-[10px] text-slate-400/60 font-medium">
          &copy; 2026 Kamomi.id &mdash; Platform Manajemen Hunian Digital
        </p>
      </div>
    </div>

  </body>
</html>
