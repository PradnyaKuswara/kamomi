---
import Navbar from "../components/layout/Navbar.tsx";
import Footer from "../components/layout/Footer.astro";
import SEOHead from "../components/layout/SEOHead.astro";
import "../styles/global.css";
---

<html lang="id" class="scroll-smooth">
  <SEOHead
    title="Kamomi.id — Platform Manajemen Hunian Digital & QR Code Pintar"
    description="Platform guestbook digital berbasis QR Code akrilik pintar untuk Kost Exclusive, Homestay, Airbnb, dan Villa. Hubungkan Wi-Fi 1-klik, tata tertib, dan lapor keluhan instan."
    keywords="kamomi, manajemen kost, guestbook digital, qr code kost, aplikasi kost, kelola homestay, manajemen villa, wifi 1 klik"
  />
  <body
    class="bg-[#FBF9F5] dark:bg-[#090D14] text-slate-900 dark:text-white font-sans antialiased selection:bg-emerald-500 selection:text-white overflow-x-hidden"
  >
    <!-- ======================= CINEMATIC NOTHIN' SPLASH SCREEN ======================= -->
    <div
      id="splash-screen"
      class="fixed inset-0 z-100 bg-[#090D14] flex flex-col items-center justify-center transition-all duration-700 ease-out"
    >
      <div id="splash-content" class="flex flex-col items-center text-center p-6 transform scale-100 transition-all duration-700">
        <div class="w-16 h-16 rounded-2xl bg-linear-to-br from-emerald-400 via-teal-500 to-cyan-500 flex items-center justify-center text-white font-black text-2xl shadow-2xl shadow-emerald-500/40 mb-5 animate-pulse">
          K
        </div>
        <h2 class="text-3xl font-black text-white tracking-tight">
          Kamomi<span class="text-emerald-500">.id</span>
        </h2>
        <p class="text-[11px] text-slate-400 font-bold uppercase tracking-[0.25em] mt-2">
          Platform Hunian Digital
        </p>
        <div class="w-32 h-1 bg-slate-800 rounded-full mt-6 overflow-hidden">
          <div id="splash-bar" class="h-full bg-linear-to-r from-emerald-400 to-teal-400 w-0 transition-all duration-500"></div>
        </div>
      </div>
    </div>

    <Navbar client:load />

    <!-- ======================= SUPERPLAY STICKY PARALLAX CONTAINER ======================= -->
    <div id="hp-track" class="relative w-full h-[400vh]">
      <!-- STICKY VIEWPORT CONTAINER -->
      <div
        id="hp-sticky"
        class="sticky top-0 h-screen w-full overflow-hidden flex flex-col justify-between pt-24 sm:pt-28 pb-8 sm:pb-10 px-4 sm:px-8"
      >
        <!-- BACKGROUND DECORATIVE GLOW & GRID -->
        <div class="absolute inset-0 pointer-events-none z-0">
          <div
            id="bg-glow-1"
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-175 h-175 bg-emerald-500/12 rounded-full blur-[140px] transition-transform duration-75 ease-out"
          >
          </div>
          <div
            id="bg-glow-2"
            class="absolute bottom-1/4 right-10 w-137.5 h-137.5 bg-teal-500/12 rounded-full blur-[120px] transition-transform duration-75 ease-out"
          >
          </div>
          <div
            class="absolute inset-0 opacity-[0.035] dark:opacity-[0.06]"
            style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 36px 36px;"
          >
          </div>
        </div>

        <!-- 3D FLOATING PARALLAX DECORATION LAYER -->
        <div
          class="absolute inset-0 pointer-events-none z-10 overflow-hidden perspective-1000"
        >
          <!-- Floating Item 1: 3D QR Card Badge (Top Left) -->
          <div
            id="p-item-1"
            class="absolute top-[12%] sm:top-[14%] left-[2%] sm:left-[3%] xl:left-[5%] w-36 sm:w-48 md:w-56 p-2.5 sm:p-4 rounded-xl sm:rounded-2xl bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-2xl transition-transform duration-75 ease-out"
          >
            <div class="flex items-center gap-2 sm:gap-3.5">
              <div
                class="w-8 h-8 sm:w-11 sm:h-11 rounded-lg sm:rounded-xl bg-linear-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-white font-black text-[10px] sm:text-xs shadow-md shadow-emerald-500/20 shrink-0"
              >
                QR
              </div>
              <div class="min-w-0">
                <p class="text-[11px] sm:text-xs font-bold text-slate-900 dark:text-white truncate">
                  Kamar 102
                </p>
                <p class="text-[9px] sm:text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5 flex items-center gap-1 truncate">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
                  Pintu Utama
                </p>
              </div>
            </div>
          </div>

          <!-- Floating Item 2: WiFi Pill Badge (Top Right) -->
          <div
            id="p-item-2"
            class="absolute top-[14%] sm:top-[16%] right-[2%] sm:right-[3%] xl:right-[5%] w-36 sm:w-52 md:w-60 p-2.5 sm:p-4 rounded-xl sm:rounded-2xl bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-2xl transition-transform duration-75 ease-out"
          >
            <div class="flex items-center justify-between gap-1.5">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-emerald-100 dark:bg-emerald-950/80 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xs sm:text-sm font-bold shrink-0">
                  📶
                </div>
                <div class="min-w-0">
                  <span class="text-[11px] sm:text-xs font-bold block text-slate-900 dark:text-white truncate">Wi-Fi 1-Klik</span>
                  <span class="text-[9px] text-slate-400 hidden sm:block">Tanpa password</span>
                </div>
              </div>
              <span
                class="text-[8px] sm:text-[9px] font-bold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full shrink-0"
                >Terhubung</span
              >
            </div>
          </div>

          <!-- Floating Item 3: Complaint Ticket Badge (Bottom Left) -->
          <div
            id="p-item-3"
            class="absolute bottom-[14%] left-[2%] sm:left-[3%] xl:left-[6%] w-36 sm:w-52 md:w-60 p-2.5 sm:p-4 rounded-xl sm:rounded-2xl bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-2xl transition-transform duration-75 ease-out hidden sm:block"
          >
            <div class="flex items-center gap-2.5 sm:gap-3.5">
              <div
                class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-amber-100 dark:bg-amber-950/80 flex items-center justify-center text-amber-600 dark:text-amber-400 text-xs sm:text-sm font-bold shadow-inner shrink-0"
              >
                🚨
              </div>
              <div class="min-w-0">
                <p class="text-[11px] sm:text-xs font-bold text-slate-900 dark:text-white truncate">
                  Lapor Kendala
                </p>
                <p class="text-[9px] sm:text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-0.5 truncate">
                  Respon &lt; 2 mnt
                </p>
              </div>
            </div>
          </div>

          <!-- Floating Item 4: Villa & Kost Badge (Bottom Right) -->
          <div
            id="p-item-4"
            class="absolute bottom-[16%] right-[2%] sm:right-[3%] xl:right-[6%] w-36 sm:w-48 md:w-56 p-2.5 sm:p-4 rounded-xl sm:rounded-2xl bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-2xl transition-transform duration-75 ease-out hidden sm:block"
          >
            <div class="flex items-center gap-2.5 sm:gap-3.5">
              <div
                class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-teal-100 dark:bg-teal-950/80 flex items-center justify-center text-teal-600 dark:text-teal-400 text-xs sm:text-sm font-bold shadow-inner shrink-0"
              >
                🏢
              </div>
              <div class="min-w-0">
                <p class="text-[11px] sm:text-xs font-bold text-slate-900 dark:text-white truncate">
                  Multi Properti
                </p>
                <p class="text-[9px] sm:text-[10px] text-teal-600 dark:text-teal-400 font-semibold mt-0.5 truncate">
                  Kost • Villa
                </p>
              </div>
            </div>
          </div>

          <!-- Prototype Image Card 1: QR Door (Middle Left) -->
          <div
            id="p-img-1"
            class="absolute top-[28%] sm:top-[32%] left-[1%] sm:left-[2%] xl:left-[4%] w-32 sm:w-44 md:w-56 p-1.5 sm:p-2 rounded-xl sm:rounded-2xl bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-2xl transition-transform duration-75 ease-out"
          >
            <img src="/qr_door.png" alt="Akrilik QR Pintu" class="w-full h-20 sm:h-28 md:h-36 object-cover rounded-lg sm:rounded-xl shadow-xs" />
            <div class="mt-1 sm:mt-2 text-center">
              <span class="text-[9px] sm:text-[10px] font-bold text-slate-700 dark:text-slate-300">Akrilik Pintu Kamar</span>
            </div>
          </div>

          <!-- Prototype Image Card 2: QR Mockup Phone (Middle Right) -->
          <div
            id="p-img-2"
            class="absolute top-[32%] sm:top-[35%] right-[1%] sm:right-[2%] xl:right-[4%] w-32 sm:w-48 md:w-60 p-1.5 sm:p-2 rounded-xl sm:rounded-2xl bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-2xl transition-transform duration-75 ease-out"
          >
            <img src="/qr_mockup.png" alt="Guestbook Portal Mockup" class="w-full h-24 sm:h-32 md:h-40 object-cover rounded-lg sm:rounded-xl shadow-xs" />
            <div class="mt-1 sm:mt-2 text-center">
              <span class="text-[9px] sm:text-[10px] font-bold text-emerald-600 dark:text-emerald-400">Portal Guestbook</span>
            </div>
          </div>

          <!-- Prototype Image Card 3: QR Wall Display (Lower Left/Center) -->
          <div
            id="p-img-3"
            class="absolute bottom-[18%] sm:bottom-[22%] left-[4%] sm:left-[8%] xl:left-[10%] w-32 sm:w-40 md:w-52 p-1.5 sm:p-2 rounded-xl sm:rounded-2xl bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-2xl transition-transform duration-75 ease-out hidden sm:block"
          >
            <img src="/qr_wall.png" alt="Display Dinding Properti" class="w-full h-20 sm:h-28 md:h-32 object-cover rounded-lg sm:rounded-xl shadow-xs" />
            <div class="mt-1 sm:mt-2 text-center">
              <span class="text-[9px] sm:text-[10px] font-bold text-slate-700 dark:text-slate-300">Display Dinding</span>
            </div>
          </div>


        </div>

        <!-- SCENE SLIDES LAYER -->
        <div class="relative z-20 max-w-4xl mx-auto w-full flex-1 flex flex-col justify-center items-center px-4">
          
          <!-- ================= SCENE 0: HERO (0.00 - 0.25) ================= -->
          <div
            id="scene-0"
            class="absolute inset-0 flex flex-col justify-center items-center text-center transition-all duration-150 pointer-events-auto my-auto"
          >
            <span
              class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-emerald-100/90 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/80 mb-6 uppercase tracking-wider shadow-xs"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              AKRILIK PINTAR QR CODE • TANPA INSTAL APLIKASI
            </span>

            <h1
              class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.15] text-slate-900 dark:text-white max-w-3xl"
            >
              Revolusi Pengalaman Tamu &<br />
              <span
                class="bg-linear-to-r from-emerald-500 via-teal-400 to-cyan-400 bg-clip-text text-transparent"
              >
                Operasional Hunian Anda
              </span>
            </h1>

            <p
              class="mt-5 sm:mt-6 text-sm sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl font-normal leading-relaxed"
            >
              Cukup 1 QR Card akrilik elegan di pintu kamar. Tamu langsung terhubung Wi-Fi 1-klik, paham tata tertib, dan lapor kendala dalam 1 detik — tanpa perlu unduh aplikasi.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-3.5 mt-8">
              <a
                href="/guest"
                class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-xs uppercase tracking-wider bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/25 transition-all transform hover:scale-102 active:scale-98 flex items-center justify-center gap-2"
              >
                <span>Lihat Demo Portal Tamu</span>
                <span class="text-sm">→</span>
              </a>
              <a
                href="/register"
                class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-xs uppercase tracking-wider bg-white dark:bg-slate-900 text-slate-800 dark:text-white border border-slate-300 dark:border-slate-800 hover:border-emerald-500 transition-all shadow-sm transform hover:scale-102 active:scale-98 text-center"
              >
                Daftar Gratis (3 Kamar)
              </a>
            </div>
          </div>

          <!-- ================= SCENE 1: STATEMENT (0.25 - 0.55) ================= -->
          <div
            id="scene-1"
            class="absolute inset-0 flex flex-col justify-center items-center text-center transition-all duration-150 opacity-0 pointer-events-none my-auto"
          >
            <h2
              class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.2] text-slate-900 dark:text-white max-w-3xl"
            >
              1 Scan QR Code,<br />
              <span
                class="bg-linear-to-r from-emerald-500 via-teal-400 to-cyan-400 bg-clip-text text-transparent"
              >
                Selesaikan Semua Masalah Tamu ⚡
              </span>
            </h2>
            <p class="mt-3 text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-lg font-medium">
              Eliminasi 90% pertanyaan berulang via WhatsApp dengan guestbook digital yang intuitif.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4.5 mt-8 w-full max-w-3xl">
              <!-- Feature Card 1 -->
              <div
                class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-xl text-left group hover:border-emerald-500/50 transition-all duration-300"
              >
                <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-lg font-bold mb-3 group-hover:scale-105 transition-transform">
                  📶
                </div>
                <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1">
                  Wi-Fi 1-Klik Instan
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                  Tamu langsung terhubung ke jaringan Wi-Fi kamar tanpa repot menanyakan password.
                </p>
              </div>

              <!-- Feature Card 2 -->
              <div
                class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-xl text-left group hover:border-emerald-500/50 transition-all duration-300"
              >
                <div class="w-10 h-10 rounded-xl bg-teal-100 dark:bg-teal-950/80 flex items-center justify-center text-teal-600 dark:text-teal-400 text-lg font-bold mb-3 group-hover:scale-105 transition-transform">
                  📋
                </div>
                <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1">
                  Panduan & Aturan Hunian
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                  Panduan alat kamar (AC, TV, Water Heater) dan tata tertib lengkap selalu dapat diakses.
                </p>
              </div>

              <!-- Feature Card 3 -->
              <div
                class="p-5 rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800/80 shadow-xl backdrop-blur-xl text-left group hover:border-emerald-500/50 transition-all duration-300"
              >
                <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/80 flex items-center justify-center text-amber-600 dark:text-amber-400 text-lg font-bold mb-3 group-hover:scale-105 transition-transform">
                  🚨
                </div>
                <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1">
                  Lapor Keluhan Realtime
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                  Kendala fasilitas terkirim realtime ke dashboard pengelola untuk penanganan cepat.
                </p>
              </div>
            </div>
          </div>

          <!-- ================= SCENE 2: SHOWCASE (0.55 - 0.80) ================= -->
          <div
            id="scene-2"
            class="absolute inset-0 flex flex-col justify-center items-center text-center transition-all duration-150 opacity-0 pointer-events-none my-auto"
          >
            <h2
              class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.2] text-slate-900 dark:text-white max-w-3xl"
            >
              Dirancang Khusus Untuk<br />
              <span
                class="bg-linear-to-r from-emerald-500 via-teal-400 to-cyan-400 bg-clip-text text-transparent"
              >
                Segala Skala Properti 🏢
              </span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4.5 mt-8 w-full max-w-3xl">
              <!-- Property Card 1 -->
              <div
                class="group rounded-2xl p-5 bg-white/80 dark:bg-slate-900/80 text-slate-900 dark:text-white text-left shadow-xl border border-slate-200/80 dark:border-slate-800/80 relative overflow-hidden backdrop-blur-xl hover:border-emerald-500/50 transition-all duration-300"
              >
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[10px] font-bold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 px-2.5 py-1 rounded-full">
                    Kost Exclusive
                  </span>
                  <span class="text-base">🛏️</span>
                </div>
                <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1.5">Kamar Tertata Rapi</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                  Informasi aturan bersama, jadwal sampah, dan kontak pengurus tersusun rapi.
                </p>
              </div>

              <!-- Property Card 2 -->
              <div
                class="group rounded-2xl p-5 bg-white/80 dark:bg-slate-900/80 text-slate-900 dark:text-white text-left shadow-xl border border-slate-200/80 dark:border-slate-800/80 relative overflow-hidden backdrop-blur-xl hover:border-teal-500/50 transition-all duration-300"
              >
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[10px] font-bold uppercase tracking-wider bg-teal-100 dark:bg-teal-950/80 text-teal-700 dark:text-teal-300 px-2.5 py-1 rounded-full">
                    Homestay & Airbnb
                  </span>
                  <span class="text-base">🏡</span>
                </div>
                <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1.5">Self Check-In Smooth</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                  Panduan lokasi, rekomendasi kuliner sekitar, & nomor darurat selalu up-to-date.
                </p>
              </div>

              <!-- Property Card 3 -->
              <div
                class="group rounded-2xl p-5 bg-white/80 dark:bg-slate-900/80 text-slate-900 dark:text-white text-left shadow-xl border border-slate-200/80 dark:border-slate-800/80 relative overflow-hidden backdrop-blur-xl hover:border-cyan-500/50 transition-all duration-300"
              >
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[10px] font-bold uppercase tracking-wider bg-cyan-100 dark:bg-cyan-950/80 text-cyan-700 dark:text-cyan-300 px-2.5 py-1 rounded-full">
                    Villa & Resort
                  </span>
                  <span class="text-base">🌴</span>
                </div>
                <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1.5">Layanan Concierge</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                  Layanan eksklusif tambahan & tiket kendala digital untuk kepuasan tamu maksimal.
                </p>
              </div>
            </div>
          </div>

          <!-- ================= SCENE 3: EXPLORE & CTA (0.80 - 1.00) ================= -->
          <div
            id="scene-3"
            class="absolute inset-0 flex flex-col justify-center items-center text-center transition-all duration-150 opacity-0 pointer-events-none my-auto"
          >
            <h2
              class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.2] text-slate-900 dark:text-white max-w-3xl"
            >
              Mulai Modernisasi Properti Anda<br />
              <span
                class="bg-linear-to-r from-emerald-500 via-teal-400 to-cyan-400 bg-clip-text text-transparent"
              >
                Setup Selesai Dalam 3 Menit 🚀
              </span>
            </h2>

            <p class="mt-4 text-xs sm:text-base text-slate-600 dark:text-slate-300 max-w-lg font-normal">
              Daftar gratis sekarang dan kelola hingga 3 kamar pertama tanpa biaya sepeser pun.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-3.5 mt-7">
              <a
                href="/register"
                class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-xs uppercase tracking-wider bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/25 transition-all transform hover:scale-102 active:scale-98"
              >
                Daftar Gratis Sekarang
              </a>
              <a
                href="/guest"
                class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-xs uppercase tracking-wider bg-white dark:bg-slate-900 text-slate-800 dark:text-white border border-slate-300 dark:border-slate-800 hover:border-emerald-500 transition-all shadow-sm transform hover:scale-102 active:scale-98"
              >
                Coba Demo Portal Tamu
              </a>
            </div>

            <!-- Stats Bar -->
            <div
              class="grid grid-cols-3 gap-6 sm:gap-8 mt-10 pt-6 border-t border-slate-200/80 dark:border-slate-800/80 w-full max-w-lg"
            >
              <div>
                <div class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400">100%</div>
                <div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider mt-1">Tanpa Aplikasi</div>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-black text-teal-500 dark:text-teal-400">3 Detik</div>
                <div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider mt-1">Scan Instant</div>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-black text-cyan-600 dark:text-cyan-400">Gratis</div>
                <div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider mt-1">3 Kamar Pertama</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ======================= FOOTER SECTION ======================= -->
    <Footer />

    <!-- ======================= LERP & 3D MULTI-AXIS ANIMATION CONTROLLER ======================= -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const track = document.getElementById("hp-track") as HTMLElement | null;
        const scene0 = document.getElementById("scene-0");
        const scene1 = document.getElementById("scene-1");
        const scene2 = document.getElementById("scene-2");
        const scene3 = document.getElementById("scene-3");

        const pItem1 = document.getElementById("p-item-1");
        const pItem2 = document.getElementById("p-item-2");
        const pItem3 = document.getElementById("p-item-3");
        const pItem4 = document.getElementById("p-item-4");
        const pImg1 = document.getElementById("p-img-1");
        const pImg2 = document.getElementById("p-img-2");
        const pImg3 = document.getElementById("p-img-3");
        const bgGlow1 = document.getElementById("bg-glow-1");
        const bgGlow2 = document.getElementById("bg-glow-2");
        const scrollIndicator = document.getElementById("scroll-indicator");

        if (!track) return;

        // Nothin' Cinematic Splash Screen & Navbar Unfold Reveal Timeline
        const splashScreen = document.getElementById("splash-screen");
        const splashContent = document.getElementById("splash-content");
        const splashBar = document.getElementById("splash-bar");
        const mainNavbar = document.getElementById("main-navbar");

        if (splashBar) {
          setTimeout(() => {
            splashBar.style.width = "100%";
          }, 50);
        }

        setTimeout(() => {
          if (splashContent) {
            splashContent.style.transform = "scale(1.25)";
            splashContent.style.opacity = "0";
          }
          if (splashScreen) {
            splashScreen.style.opacity = "0";
            splashScreen.style.pointerEvents = "none";
          }
          if (mainNavbar) {
            setTimeout(() => {
              mainNavbar.classList.remove("opacity-0", "-translate-y-6");
              mainNavbar.classList.add("opacity-100", "translate-y-0");
            }, 300);
          }
        }, 650);

        let targetProgress = 0;
        let currentProgress = 0;
        const lerpFactor = 0.075;

        // Interactive 3D Mouse & Touch Parallax Tracking
        let targetMouseX = 0;
        let targetMouseY = 0;
        let currentMouseX = 0;
        let currentMouseY = 0;

        window.addEventListener("mousemove", (e) => {
          targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2;
          targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2;
        }, { passive: true });

        // Touch Drag 3D Tilt for Mobile Devices
        window.addEventListener("touchmove", (e) => {
          if (e.touches.length > 0) {
            targetMouseX = (e.touches[0].clientX / window.innerWidth - 0.5) * 2;
            targetMouseY = (e.touches[0].clientY / window.innerHeight - 0.5) * 2;
          }
        }, { passive: true });

        function onScroll() {
          if (!track) return;
          const rect = track.getBoundingClientRect();
          const totalScroll = track.offsetHeight - window.innerHeight;
          const currentScroll = Math.max(0, -rect.top);

          let p = totalScroll > 0 ? currentScroll / totalScroll : 0;
          targetProgress = Math.min(Math.max(p, 0), 1);
        }

        function calculateOpacity(p: number, start: number, peakStart: number, peakEnd: number, end: number) {
          if (p < start || p > end) return 0;
          if (p >= peakStart && p <= peakEnd) return 1;
          if (p < peakStart) return (p - start) / (peakStart - start);
          return 1 - (p - peakEnd) / (end - peakEnd);
        }

        function animateLoop(now: number) {
          // Lerp Scroll & Mouse Coordinates for 250 Broadway Fluidity
          currentProgress += (targetProgress - currentProgress) * lerpFactor;
          currentMouseX += (targetMouseX - currentMouseX) * 0.05;
          currentMouseY += (targetMouseY - currentMouseY) * 0.05;

          const p = currentProgress;
          const t = now * 0.0015; // Continuous Levitation Clock

          // Continuous Floating Oscillation Vectors
          const float1 = Math.sin(t) * 14;
          const float2 = Math.cos(t * 0.85) * 16;
          const float3 = Math.sin(t * 1.1 + 1) * 12;
          const rotFloat1 = Math.sin(t * 0.7) * 4;
          const rotFloat2 = Math.cos(t * 0.9) * 5;

          // ----------------------------------------------------
          // MULTI-STAGE 3D SPATIAL WAYPOINT TRAJECTORY ENGINE
          // ----------------------------------------------------
          type KeyframePoint = {
            p: number; x: number; y: number; z: number;
            rx: number; ry: number; rz: number; s: number;
          };

          function getInterpolatedState(pVal: number, points: KeyframePoint[]) {
            if (pVal <= points[0].p) return points[0];
            if (pVal >= points[points.length - 1].p) return points[points.length - 1];

            let idx = 0;
            while (idx < points.length - 1 && points[idx + 1].p < pVal) {
              idx++;
            }

            const pt1 = points[idx];
            const pt2 = points[idx + 1];
            const progress = (pVal - pt1.p) / (pt2.p - pt1.p);
            const ease = progress * progress * (3 - 2 * progress); // Cubic Smoothstep

            return {
              x: pt1.x + (pt2.x - pt1.x) * ease,
              y: pt1.y + (pt2.y - pt1.y) * ease,
              z: pt1.z + (pt2.z - pt1.z) * ease,
              rx: pt1.rx + (pt2.rx - pt1.rx) * ease,
              ry: pt1.ry + (pt2.ry - pt1.ry) * ease,
              rz: pt1.rz + (pt2.rz - pt1.rz) * ease,
              s: pt1.s + (pt2.s - pt1.s) * ease,
            };
          }

          // Trajectory 1: Prototype Image 1 (QR Door) — Swings Right -> Down -> Crosses Left -> Up
          const waypointsImg1: KeyframePoint[] = [
            { p: 0.00, x: 0, y: 0, z: 0, rx: 0, ry: 0, rz: -6, s: 0.9 },
            { p: 0.28, x: 220, y: 160, z: 110, rx: 24, ry: -38, rz: 18, s: 1.18 },
            { p: 0.58, x: -260, y: 90, z: -90, rx: -32, ry: 42, rz: -26, s: 0.82 },
            { p: 0.85, x: 140, y: -180, z: 70, rx: 18, ry: -22, rz: 12, s: 1.08 },
            { p: 1.00, x: -30, y: -300, z: 20, rx: 0, ry: 0, rz: 0, s: 0.95 }
          ];

          // Trajectory 2: Prototype Image 2 (QR Mockup) — Swings Down-Left -> Crosses Top-Right -> Down
          const waypointsImg2: KeyframePoint[] = [
            { p: 0.00, x: 0, y: 0, z: 0, rx: 0, ry: 0, rz: 8, s: 1.0 },
            { p: 0.28, x: -240, y: 200, z: -70, rx: -32, ry: 48, rz: -22, s: 0.82 },
            { p: 0.58, x: 280, y: -140, z: 130, rx: 38, ry: -52, rz: 32, s: 1.22 },
            { p: 0.85, x: -160, y: -240, z: 50, rx: -18, ry: 24, rz: -14, s: 0.94 },
            { p: 1.00, x: 70, y: -320, z: 0, rx: 0, ry: 0, rz: 0, s: 1.0 }
          ];

          // Trajectory 3: Prototype Image 3 (QR Wall) — Swings Up-Right -> Top-Left -> Bottom-Right
          const waypointsImg3: KeyframePoint[] = [
            { p: 0.00, x: 0, y: 0, z: 0, rx: 0, ry: 0, rz: -4, s: 0.85 },
            { p: 0.28, x: 260, y: -190, z: 90, rx: 22, ry: -32, rz: 28, s: 1.12 },
            { p: 0.58, x: -200, y: -270, z: -110, rx: -28, ry: 38, rz: -18, s: 0.78 },
            { p: 0.85, x: 220, y: 160, z: 110, rx: 32, ry: -42, rz: 22, s: 1.16 },
            { p: 1.00, x: 0, y: 240, z: 30, rx: 0, ry: 0, rz: 0, s: 1.0 }
          ];

          // Trajectory Badges 1-4
          const waypointsItem1: KeyframePoint[] = [
            { p: 0.00, x: 0, y: 0, z: 0, rx: 0, ry: 0, rz: -30, s: 1.0 },
            { p: 0.30, x: -160, y: -120, z: 40, rx: 12, ry: -15, rz: -40, s: 0.85 },
            { p: 0.65, x: 180, y: 160, z: -60, rx: -18, ry: 20, rz: 25, s: 1.1 },
            { p: 1.00, x: -90, y: -180, z: 0, rx: 0, ry: 0, rz: -15, s: 0.9 }
          ];

          const waypointsItem2: KeyframePoint[] = [
            { p: 0.00, x: 0, y: 0, z: 0, rx: 0, ry: 0, rz: 35, s: 1.0 },
            { p: 0.30, x: 180, y: 140, z: -50, rx: -15, ry: 18, rz: 45, s: 1.12 },
            { p: 0.65, x: -190, y: -150, z: 60, rx: 20, ry: -22, rz: -20, s: 0.88 },
            { p: 1.00, x: 100, y: -140, z: 0, rx: 0, ry: 0, rz: 20, s: 1.0 }
          ];

          // Apply Interpolated Waypoints + 3D Mouse Parallax + Levitation Clock
          if (pImg1) {
            const st = getInterpolatedState(p, waypointsImg1);
            pImg1.style.transform = `perspective(1200px) translate3d(${st.x + currentMouseX * -25}px, ${st.y + float2 + currentMouseY * -22}px, ${st.z}px) rotateX(${st.rx + currentMouseY * 14}deg) rotateY(${st.ry + currentMouseX * -18}deg) rotateZ(${st.rz + rotFloat1}deg) scale(${st.s})`;
            pImg1.style.filter = `blur(${Math.max(0, Math.abs(st.z - 20) * 0.035).toFixed(1)}px)`;
          }

          if (pImg2) {
            const st = getInterpolatedState(p, waypointsImg2);
            pImg2.style.transform = `perspective(1200px) translate3d(${st.x + currentMouseX * 28}px, ${st.y + float1 + currentMouseY * 25}px, ${st.z}px) rotateX(${st.rx + currentMouseY * -16}deg) rotateY(${st.ry + currentMouseX * 20}deg) rotateZ(${st.rz + rotFloat2}deg) scale(${st.s})`;
            pImg2.style.filter = `blur(${Math.max(0, Math.abs(st.z - 20) * 0.035).toFixed(1)}px)`;
          }

          if (pImg3) {
            const st = getInterpolatedState(p, waypointsImg3);
            pImg3.style.transform = `perspective(1200px) translate3d(${st.x + currentMouseX * -18}px, ${st.y + float3 + currentMouseY * -16}px, ${st.z}px) rotateX(${st.rx + currentMouseY * 12}deg) rotateY(${st.ry + currentMouseX * -12}deg) rotateZ(${st.rz + rotFloat1}deg) scale(${st.s})`;
            pImg3.style.filter = `blur(${Math.max(0, Math.abs(st.z - 20) * 0.035).toFixed(1)}px)`;
          }

          if (pItem1) {
            const st = getInterpolatedState(p, waypointsItem1);
            pItem1.style.transform = `perspective(1000px) translate3d(${st.x + currentMouseX * -15}px, ${st.y + float1 + currentMouseY * -12}px, ${st.z}px) rotateX(${st.rx + currentMouseY * 10}deg) rotateY(${st.ry + currentMouseX * -10}deg) rotateZ(${st.rz + rotFloat1}deg) scale(${st.s})`;
          }

          if (pItem2) {
            const st = getInterpolatedState(p, waypointsItem2);
            pItem2.style.transform = `perspective(1000px) translate3d(${st.x + currentMouseX * 18}px, ${st.y + float2 + currentMouseY * 15}px, ${st.z}px) rotateX(${st.rx + currentMouseY * -12}deg) rotateY(${st.ry + currentMouseX * 12}deg) rotateZ(${st.rz + rotFloat2}deg) scale(${st.s})`;
          }

          if (pItem3) {
            pItem3.style.transform = `perspective(1000px) translate3d(${p * -160 + currentMouseX * -20}px, ${p * 220 + float3 + currentMouseY * -18}px, 0) rotateX(${currentMouseY * 8}deg) rotateY(${currentMouseX * -8}deg) rotateZ(${p * 25 + rotFloat1}deg) scale(${1 - p * 0.1})`;
          }
          if (pItem4) {
            pItem4.style.transform = `perspective(1000px) translate3d(${p * 170 + currentMouseX * 22}px, ${p * 200 + float1 + currentMouseY * 20}px, 0) rotateX(${currentMouseY * -10}deg) rotateY(${currentMouseX * 10}deg) rotateZ(${p * -25 + rotFloat2}deg) scale(${1 + p * 0.12})`;
          }



          // Background Glow Dynamic Lighting Shifts
          if (bgGlow1) {
            bgGlow1.style.transform = `translate(-50%, -50%) translate3d(${currentMouseX * 40}px, ${currentMouseY * 40}px, 0) scale(${1 + p * 0.8})`;
          }
          if (bgGlow2) {
            bgGlow2.style.transform = `translate(${p * -120 + currentMouseX * -50}px, ${p * -120 + currentMouseY * -50}px) scale(${1 + p * 0.6})`;
          }

          // 3. Interpolate Scenes Opacity & Camera Fly-Through Tunnel Zoom (Nothin' Style)
          const op0 = calculateOpacity(p, 0.0, 0.0, 0.18, 0.28);
          const op1 = calculateOpacity(p, 0.22, 0.30, 0.48, 0.58);
          const op2 = calculateOpacity(p, 0.52, 0.60, 0.75, 0.82);
          const op3 = calculateOpacity(p, 0.78, 0.85, 1.0, 1.0);

          if (scene0) {
            scene0.style.opacity = op0.toFixed(3);
            const zoomOut = 1 + (1 - op0) * 2.2;
            const flyZ = (1 - op0) * 450;
            scene0.style.transform = `perspective(1000px) translate3d(${currentMouseX * 12}px, ${(0.18 - Math.min(p, 0.18)) * -120 + currentMouseY * 12}px, ${flyZ}px) rotateX(${currentMouseY * -4}deg) rotateY(${currentMouseX * 4}deg) scale(${zoomOut})`;
            scene0.style.pointerEvents = op0 > 0.5 ? "auto" : "none";
          }

          if (scene1) {
            scene1.style.opacity = op1.toFixed(3);
            const zoomIn = 0.4 + op1 * 0.6;
            const flyZ = (1 - op1) * -350;
            scene1.style.transform = `perspective(1000px) translate3d(${currentMouseX * 12}px, ${(0.35 - p) * 90 + currentMouseY * 12}px, ${flyZ}px) rotateX(${currentMouseY * -4}deg) rotateY(${currentMouseX * 4}deg) scale(${zoomIn})`;
            scene1.style.pointerEvents = op1 > 0.5 ? "auto" : "none";
          }

          if (scene2) {
            scene2.style.opacity = op2.toFixed(3);
            const zoomIn = 0.4 + op2 * 0.6;
            const flyZ = (1 - op2) * -350;
            scene2.style.transform = `perspective(1000px) translate3d(${currentMouseX * 12}px, ${(0.65 - p) * 90 + currentMouseY * 12}px, ${flyZ}px) rotateX(${currentMouseY * -4}deg) rotateY(${currentMouseX * 4}deg) scale(${zoomIn})`;
            scene2.style.pointerEvents = op2 > 0.5 ? "auto" : "none";
          }

          if (scene3) {
            scene3.style.opacity = op3.toFixed(3);
            const zoomIn = 0.4 + op3 * 0.6;
            const flyZ = (1 - op3) * -350;
            scene3.style.transform = `perspective(1000px) translate3d(${currentMouseX * 12}px, ${(0.90 - p) * 90 + currentMouseY * 12}px, ${flyZ}px) rotateX(${currentMouseY * -4}deg) rotateY(${currentMouseX * 4}deg) scale(${zoomIn})`;
            scene3.style.pointerEvents = op3 > 0.5 ? "auto" : "none";
          }

          // Hide scroll indicator near bottom
          if (scrollIndicator) {
            scrollIndicator.style.opacity = p > 0.85 ? "0" : "1";
          }

          requestAnimationFrame(animateLoop);
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
        requestAnimationFrame(animateLoop);
      });
    </script>
  </body>
</html>
