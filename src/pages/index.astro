---
import Navbar from '../components/Navbar.jsx';
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>Kamomi.id - Asisten Pintar Kamar Kamu</title>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased scroll-smooth">
    <Navbar client:load />

    {/* Hero Section */}
    <header class="relative pt-36 pb-24 overflow-hidden px-4 md:px-8">
      {/* Subtle warm glow background element */}
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        {/* Left Text Presentation */}
        <div class="lg:col-span-7 space-y-8 text-left">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-400 border border-cyan-200/30">
            🌿 Modern Smart Room Assistant
          </span>
          
          <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
            Asisten Pintar Kamar Kost, <br />
            Homestay & Villa Anda.
          </h1>

          <p class="text-base sm:text-lg text-slate-500 dark:text-slate-400 leading-relaxed max-w-2xl">
            Tinggalkan buku panduan fisik kusam. Tempel stiker QR premium di pintu kamar Anda. Tamu cukup memindai untuk mengakses Wi-Fi secara instan, membaca tata tertib, dan melaporkan kendala dalam hitungan detik.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a 
              href="/register" 
              class="px-8 py-4 rounded-2xl font-bold text-sm bg-cyan-600 text-white hover:bg-cyan-700 transition-all text-center shadow-lg shadow-cyan-500/10"
            >
              Mulai Secara Gratis
            </a>
            <a 
              href="/guest" 
              class="px-8 py-4 rounded-2xl font-bold text-sm border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-900 transition-all text-center flex items-center justify-center gap-2"
            >
              Lihat Tampilan Demo Tamu
            </a>
          </div>

          <div class="grid grid-cols-3 gap-6 pt-6 border-t border-slate-200/50 dark:border-slate-800/50">
            <div>
              <div class="text-2xl font-black text-slate-800 dark:text-white">100%</div>
              <div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider mt-1">Tanpa Aplikasi</div>
            </div>
            <div>
              <div class="text-2xl font-black text-slate-800 dark:text-white">3 Detik</div>
              <div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider mt-1">Setup Kamar</div>
            </div>
            <div>
              <div class="text-2xl font-black text-slate-800 dark:text-white">0 Kertas</div>
              <div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider mt-1">Ramah Lingkungan</div>
            </div>
          </div>
        </div>

        {/* Right High-Fidelity UI Presentation */}
        <div class="lg:col-span-5 relative">
          <div class="absolute inset-0 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="relative rounded-3xl border border-slate-200/50 dark:border-slate-800/50 bg-white dark:bg-slate-900/40 p-5 shadow-2xl backdrop-blur-md">
            {/* Visual Header */}
            <div class="flex justify-between items-center pb-4 border-b border-slate-200/50 dark:border-slate-800/50">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Kombinasi Kartu & Web App</span>
              <div class="flex gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-slate-200 dark:bg-slate-800"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-slate-200 dark:bg-slate-800"></span>
              </div>
            </div>
            {/* Live Guest Portal Mobile Simulation */}
            <div class="mt-4 bg-slate-50 dark:bg-slate-900/80 rounded-2xl border border-slate-200/50 dark:border-slate-800/50 p-4 space-y-4 shadow-inner text-left">
              <div class="flex items-center justify-between pb-3 border-b border-slate-200/50 dark:border-slate-800/50">
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Live Tamu Portal</span>
                </div>
                <span class="text-[10px] font-bold bg-cyan-100 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-400 px-2 py-0.5 rounded-full">Kamar 102</span>
              </div>
              
              {/* Simulated WiFi Card */}
              <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800/60 shadow-xs space-y-3">
                <div class="flex justify-between items-start">
                  <div>
                    <span class="text-[9px] uppercase font-bold text-slate-400">Koneksi Internet</span>
                    <h5 class="text-sm font-bold text-slate-800 dark:text-white">Wi-Fi Kamar Aktif</h5>
                  </div>
                  <div class="p-1.5 bg-cyan-50 dark:bg-cyan-950/30 rounded-lg text-cyan-600 dark:text-cyan-400">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071a10.5 10.5 0 0114.14 0M1.344 6.564a16.5 16.5 0 0121.312 0" /></svg>
                  </div>
                </div>
                <div class="flex flex-col gap-1.5 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-950/40 border border-slate-100 dark:border-slate-800/60 text-xs">
                  <div class="flex justify-between"><span class="text-slate-400">SSID:</span><span class="font-semibold text-slate-700 dark:text-slate-300">Kamomi_Kamar102</span></div>
                  <div class="flex justify-between"><span class="text-slate-400">Password:</span><span class="font-semibold text-slate-700 dark:text-slate-300">kamomipassword</span></div>
                </div>
                <button class="w-full py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg font-bold text-[11px] shadow-xs cursor-pointer transition-all">Salin Password & Hubungkan</button>
              </div>

              {/* Quick Actions */}
              <div class="grid grid-cols-2 gap-2 text-xs">
                <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800/60 rounded-xl space-y-1">
                  <span class="text-slate-400">🔒 Tata Tertib</span>
                  <p class="text-[10px] text-slate-600 dark:text-slate-300 leading-normal">Quiet hours mulai jam 22.00 WIB.</p>
                </div>
                <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800/60 rounded-xl space-y-1">
                  <span class="text-slate-400">🛠️ Lapor Keluhan</span>
                  <p class="text-[10px] text-slate-600 dark:text-slate-300 leading-normal">Lapor AC mati langsung ke admin.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </header>

    {/* Section: Showcase By Property Types */}
    <section class="py-24 bg-slate-100/50 dark:bg-slate-900/20 border-y border-slate-200/30 dark:border-slate-800/20 px-4">
      <div class="max-w-7xl mx-auto space-y-16">
        
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <h2 class="text-3xl font-extrabold text-slate-800 dark:text-white tracking-tight">
            Didesain Khusus untuk Bisnis Properti Anda
          </h2>
          <p class="text-sm text-slate-400 dark:text-slate-500">
            Satu platform cerdas dengan gaya kustom yang pas untuk berbagai model hospitality
          </p>
        </div>

        {/* Asymmetric Grid */}
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          
          {/* Card 1: Kost & Guesthouse */}
          <div class="md:col-span-8 group relative rounded-3xl overflow-hidden border border-slate-200/40 dark:border-slate-800/40 shadow-lg h-80 flex flex-col md:flex-row bg-slate-900 dark:bg-slate-950 text-white hover:-translate-y-1 transition-all duration-300">
            {/* Left Side: Property Context (Kost Room) */}
            <div class="relative w-full md:w-1/2 h-40 md:h-full overflow-hidden">
              <img 
                src="https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=600&q=80" 
                alt="Kamar Kost Premium" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-slate-950/25"></div>
              <div class="absolute bottom-4 left-4 z-10">
                <span class="inline-block bg-cyan-600 text-white text-[9px] font-black uppercase px-2.5 py-1 rounded-full tracking-wider">
                  Kost & Guesthouse
                </span>
              </div>
            </div>
            
            {/* Right Side: QR Prototype in Action */}
            <div class="relative w-full md:w-1/2 h-40 md:h-full overflow-hidden border-t md:border-t-0 md:border-l border-slate-200/10 dark:border-slate-800/30">
              <img 
                src="/qr_wall.png" 
                alt="QR Tempel Dinding" 
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/50 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 z-10 space-y-1">
                <span class="inline-block bg-emerald-600 text-white text-[8px] font-bold px-2 py-0.5 rounded-md mb-1">PROTOTIPE: Tempel Dinding</span>
                <h3 class="font-extrabold text-sm text-white tracking-tight leading-snug">Kamar Tertata & Wi-Fi Siap Pakai</h3>
                <p class="text-[10px] text-slate-300 leading-relaxed line-clamp-2">
                  Mengurangi beban menjawab pertanyaan yang sama berulang-ulang dari anak kost baru secara otomatis.
                </p>
              </div>
            </div>
          </div>

          {/* Card 2: Homestay & Airbnb */}
          <div class="md:col-span-4 group relative rounded-3xl overflow-hidden border border-slate-200/40 dark:border-slate-800/40 shadow-lg h-80 flex flex-col bg-slate-900 dark:bg-slate-950 text-white hover:-translate-y-1 transition-all duration-300">
            {/* Top: Homestay Context */}
            <div class="relative w-full h-1/2 overflow-hidden">
              <img 
                src="https://images.unsplash.com/photo-1554995207-c18c203602cb?auto=format&fit=crop&w=400&q=80" 
                alt="Homestay Cozy" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-slate-950/25"></div>
              <div class="absolute bottom-3 left-4 z-10">
                <span class="inline-block bg-cyan-600 text-white text-[9px] font-black uppercase px-2.5 py-1 rounded-full tracking-wider">
                  Homestay & Airbnb
                </span>
              </div>
            </div>
            
            {/* Bottom: QR Gagang Pintu */}
            <div class="relative w-full h-1/2 overflow-hidden border-t border-slate-200/10 dark:border-slate-800/30">
              <img 
                src="/qr_door.png" 
                alt="QR Gagang Pintu" 
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/50 to-transparent"></div>
              <div class="absolute bottom-3 left-4 right-4 z-10 space-y-1">
                <span class="inline-block bg-amber-600 text-slate-950 text-[8px] font-bold px-2 py-0.5 rounded-md mb-1">PROTOTIPE: Gantung Pintu</span>
                <h3 class="font-extrabold text-sm text-white tracking-tight leading-snug">Aturan Ramah Tamu</h3>
                <p class="text-[10px] text-slate-300 leading-normal line-clamp-1">
                  Permudah tamu luar kota beradaptasi dengan homestay Anda.
                </p>
              </div>
            </div>
          </div>

          {/* Card 3: Villa & Resort */}
          <div class="md:col-span-12 group relative rounded-3xl overflow-hidden border border-slate-200/40 dark:border-slate-800/40 shadow-lg h-80 flex flex-col md:flex-row bg-slate-900 dark:bg-slate-950 text-white hover:-translate-y-1 transition-all duration-300">
            {/* Left Side: Property Context (Villa) */}
            <div class="relative w-full md:w-1/2 h-40 md:h-full overflow-hidden">
              <img 
                src="https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80" 
                alt="Villa Mewah" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-slate-950/25"></div>
              <div class="absolute bottom-4 left-4 z-10">
                <span class="inline-block bg-cyan-600 text-white text-[9px] font-black uppercase px-2.5 py-1 rounded-full tracking-wider">
                  Villa & Resort
                </span>
              </div>
            </div>
            
            {/* Right Side: QR Prototype in Action */}
            <div class="relative w-full md:w-1/2 h-40 md:h-full overflow-hidden border-t md:border-t-0 md:border-l border-slate-200/10 dark:border-slate-800/30">
              <img 
                src="/qr_mockup.png" 
                alt="QR Stand Akrilik Meja" 
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/50 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 z-10 space-y-1">
                <span class="inline-block bg-violet-600 text-white text-[8px] font-bold px-2 py-0.5 rounded-md mb-1">PROTOTIPE: Akrilik Meja</span>
                <h3 class="font-extrabold text-sm text-white tracking-tight leading-snug">Layanan Premium & Laporan Keluhan</h3>
                <p class="text-[10px] text-slate-300 leading-relaxed line-clamp-2">
                  Tamu dapat melaporkan kendala teknis (AC mati, TV eror) secara langsung melalui sistem tiket keluhan terintegrasi.
                </p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* Section: Simple CTA */}
    <section class="py-24 px-4 text-center space-y-8 relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-cyan-600/5 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="max-w-4xl mx-auto space-y-6 relative">
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-800 dark:text-white">
          Siap Meningkatkan Layanan Kamar Anda?
        </h2>
        <p class="text-sm sm:text-base text-slate-400 dark:text-slate-500 max-w-xl mx-auto">
          Daftar sekarang gratis untuk 3 kamar pertama Anda. Rasakan kemudahan manajemen tamu berbasis digital tanpa repot.
        </p>
        <div class="flex justify-center pt-2">
          <a
            href="/register"
            class="px-8 py-4 bg-cyan-600 hover:bg-cyan-700 text-white rounded-2xl font-bold text-xs shadow-lg shadow-cyan-500/10 transition-all"
          >
            Mulai Secara Gratis
          </a>
        </div>
      </div>
    </section>

    {/* Footer */}
    <footer class="bg-slate-900 text-slate-400 py-12 px-4 border-t border-slate-800 mt-auto">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-2">
          <span class="text-lg font-extrabold tracking-tight text-white">Kamomi<span class="text-xs text-slate-500 font-semibold">.id</span></span>
        </div>
        <p class="text-xs text-slate-500">© 2026 Kamomi.id. All rights reserved. Slogan: "Asisten Pintar Kamar Kamu"</p>
        <div class="flex gap-4">
          <a href="/terms" class="text-xs text-slate-500 hover:text-white transition-colors">Syarat & Ketentuan</a>
          <a href="/privacy" class="text-xs text-slate-500 hover:text-white transition-colors">Kebijakan Privasi</a>
        </div>
      </div>
    </footer>
  </body>
</html>
