---
import Navbar from '../../components/Navbar.jsx';
import '../../styles/global.css';
import { posts } from '../../data/posts.js';

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Filter out current post to recommend others
const otherPosts = posts.filter((p) => p.slug !== post.slug).slice(0, 2);
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} - Kamomi.id</title>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased scroll-smooth">
    <Navbar client:load />

    <main class="flex-1 pt-32 pb-20 px-4 md:px-8">
      <div class="max-w-4xl mx-auto space-y-8">
        
        {/* Breadcrumb */}
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 dark:text-slate-500">
          <a href="/" class="hover:text-cyan-500 transition-colors">Beranda</a>
          <span>/</span>
          <a href="/blog" class="hover:text-cyan-500 transition-colors">Blog</a>
          <span>/</span>
          <span class="text-slate-600 dark:text-slate-300 truncate max-w-xs">{post.title}</span>
        </nav>

        {/* Header Block */}
        <div class="space-y-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-cyan-100 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-400 border border-cyan-200/30 w-fit">
            {post.category}
          </span>
          <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-800 dark:text-white leading-tight">
            {post.title}
          </h1>
          <div class="flex items-center gap-3 text-xs text-slate-400 dark:text-slate-500 pt-2">
            <span>Oleh <strong class="text-slate-600 dark:text-slate-300">{post.author}</strong></span>
            <span>•</span>
            <span>{post.date}</span>
          </div>
        </div>

        {/* Featured Image */}
        <div class="h-64 sm:h-110 w-full overflow-hidden rounded-3xl border border-slate-200/50 dark:border-slate-800/50 shadow-lg">
          <img 
            src={post.image} 
            alt={post.title} 
            class="w-full h-full object-cover"
          />
        </div>

        {/* Content & Sidebar Grid */}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 pt-4">
          
          {/* Main Article Content */}
          <article class="lg:col-span-2 space-y-6 text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed dark:prose-invert">
            <div set:html={post.content} />
          </article>

          {/* Sidebar Banner CTA */}
          <aside class="lg:col-span-1 space-y-6">
            <div class="p-6 rounded-3xl bg-linear-to-b from-cyan-600 to-cyan-700 text-white shadow-xl space-y-5 border border-cyan-500/20 relative overflow-hidden">
              <div class="absolute -top-12 -right-12 w-28 h-28 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
              
              <div class="space-y-2">
                <span class="text-[9px] font-black uppercase bg-white/20 px-2.5 py-1 rounded-full inline-block tracking-wider">KAMOMI.ID</span>
                <h4 class="font-extrabold text-lg leading-snug">Buat Kartu QR Kamar Anda Sendiri</h4>
                <p class="text-xs text-cyan-100/90 leading-relaxed">
                  Tinggalkan buku aturan fisik kusam sekarang. Mudahkan tamu terhubung Wi-Fi dan lapor kendala.
                </p>
              </div>

              <a 
                href="/register"
                class="block w-full py-3 bg-white text-cyan-700 hover:bg-slate-50 transition-all font-bold text-xs rounded-2xl text-center shadow-lg shadow-cyan-900/10"
              >
                Mulai Gratis 3 Kamar
              </a>
            </div>

            {/* Read Next Widget */}
            <div class="p-6 rounded-3xl glassmorphic border border-slate-200/50 dark:border-slate-800/50 space-y-4">
              <h4 class="font-bold text-xs text-slate-800 dark:text-white uppercase tracking-wider">Artikel Lainnya</h4>
              <div class="space-y-4 divide-y divide-slate-100 dark:divide-slate-800/60">
                {otherPosts.map((other, idx) => (
                  <div class={`${idx > 0 ? 'pt-4' : ''} space-y-1.5`}>
                    <span class="text-[9px] uppercase font-bold text-cyan-600 dark:text-cyan-400">{other.category}</span>
                    <a href={`/blog/${other.slug}`} class="block font-bold text-xs text-slate-800 dark:text-white hover:text-cyan-500 dark:hover:text-cyan-400 transition-colors leading-snug">
                      {other.title}
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </aside>

        </div>

      </div>
    </main>

    {/* Footer */}
    <footer class="bg-slate-900 text-slate-400 py-12 px-4 border-t border-slate-800 mt-auto">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-2">
          <span class="text-lg font-extrabold tracking-tight text-white">Kamomi<span class="text-xs text-slate-500 font-semibold">.id</span></span>
        </div>
        <p class="text-xs text-slate-500">© 2026 Kamomi.id. All rights reserved. Slogan: "Asisten Pintar Kamar Kamu"</p>
        <div class="flex gap-4">
          <a href="/terms" class="text-xs text-slate-500 hover:text-white transition-colors">Syarat & Ketentuan</a>
          <a href="/privacy" class="text-xs text-slate-500 hover:text-white transition-colors">Kebijakan Privasi</a>
        </div>
      </div>
    </footer>
  </body>
</html>
