---
import Navbar from "../components/layout/Navbar.tsx";
import Footer from "../components/layout/Footer.astro";
import SEOHead from "../components/layout/SEOHead.astro";
import "../styles/global.css";
import { posts } from "../data/posts.js";
---

<html lang="id">
  <SEOHead
    title="Blog & Edukasi Kost - Kamomi.id"
    description="Artikel, tips, dan panduan praktis seputar pengelolaan kost, bisnis hunian sewa, serta teknologi manajemen properti terbaru dari Kamomi.id."
    keywords="blog kamomi, tips bisnis kost, panduan pengelola kost, edukasi properti sewa"
  />
  <body
    class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased scroll-smooth"
  >
    <Navbar client:load />

    <main class="flex-1 pt-32 pb-20 px-4">
      <div class="max-w-7xl mx-auto space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-400 border border-cyan-200/30"
          >
            📰 Blog & Edukasi
          </span>
          <h1
            class="text-4xl font-black text-slate-800 dark:text-white tracking-tight"
          >
            Tips & Trik Mengelola Kost dan Homestay
          </h1>
          <p class="text-sm text-slate-400 dark:text-slate-500">
            Temukan panduan praktis meningkatkan okupansi dan digitalisasi
            operasional penginapan Anda
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            posts.map((post) => (
              <div class="glassmorphic rounded-3xl overflow-hidden border border-slate-200/50 dark:border-slate-800/50 shadow-md group hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
                <div>
                  <div class="h-48 overflow-hidden">
                    <img
                      src={post.image}
                      alt={post.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                  <div class="p-6 space-y-3">
                    <span class="text-[10px] font-black uppercase text-cyan-600 dark:text-cyan-400 tracking-wider">
                      {post.category}
                    </span>
                    <h3 class="font-extrabold text-slate-800 dark:text-white text-base leading-snug">
                      {post.title}
                    </h3>
                    <p class="text-xs text-slate-400 dark:text-slate-500 line-clamp-3 leading-relaxed">
                      {post.excerpt}
                    </p>
                  </div>
                </div>
                <div class="p-6 pt-0">
                  <a
                    href={`/blog/${post.slug}`}
                    class="text-xs text-cyan-600 dark:text-cyan-400 font-bold hover:underline"
                  >
                    Baca Selengkapnya →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
